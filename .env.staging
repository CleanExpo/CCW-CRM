# CCW-Online ERP - Local Staging Environment
# Generated for local testing - DO NOT use in production

# ENVIRONMENT
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

# DATABASE
POSTGRES_DB=ccw_erp_staging
POSTGRES_USER=starter_user
POSTGRES_PASSWORD=staging_password_local_only_not_for_prod

# REDIS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis_staging_local_test
CACHE_ENABLED=true

# JWT (Generated for local testing only)
JWT_SECRET_KEY=local_staging_test_key_not_for_production_use_only_for_testing_minimum_64_chars_required_for_jwt
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# SECURITY
SECURE_COOKIES=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# PORTS
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# OPTIONAL - Not required for load testing
SENDGRID_API_KEY=test_key
SENTRY_DSN=
SLACK_WEBHOOK_URL=
XERO_MODE=demo
STRIPE_SECRET_KEY=
AI_PROVIDER=ollama
