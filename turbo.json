{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.local", ".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"]
    },
    "clean": {
      "cache": false
    },
    "docs:verify": {
      "cache": false,
      "inputs": [
        "apps/backend/src/api/routes/**/*.py",
        "apps/web/app/**/page.tsx",
        "apps/backend/src/db/*.py"
      ],
      "outputs": ["docs/catalogs/**"]
    }
  }
}
