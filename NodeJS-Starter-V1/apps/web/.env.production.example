# Production Environment Variables for Frontend (Next.js)
# Copy this file to .env.production.local and update with your production values

# ============================================
# Backend API Configuration
# ============================================
# CRITICAL: Update with your production backend URL
# Railway example: https://ccw-erp-backend.up.railway.app
# Fly.io example: https://ccw-erp-backend.fly.dev
NEXT_PUBLIC_BACKEND_URL=https://your-backend-domain.railway.app

# ============================================
# Frontend URL (for CORS and callbacks)
# ============================================
# Your Vercel deployment URL
NEXT_PUBLIC_FRONTEND_URL=https://ccw-erp.vercel.app

# ============================================
# App Configuration
# ============================================
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="CCW Equipment Supplier ERP"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ============================================
# AI Features (Optional)
# ============================================
# If using client-side AI features
NEXT_PUBLIC_AI_ENABLED=true

# ============================================
# Analytics (Optional)
# ============================================
# Vercel Analytics (auto-enabled on Vercel)
# Google Analytics
NEXT_PUBLIC_GA_ID=

# ============================================
# Error Tracking (Optional)
# ============================================
# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=

# ============================================
# Feature Flags (Optional)
# ============================================
NEXT_PUBLIC_FEATURE_VOICE_ASSISTANT=false
NEXT_PUBLIC_FEATURE_AI_INSIGHTS=true
NEXT_PUBLIC_FEATURE_MULTI_STORE=true
