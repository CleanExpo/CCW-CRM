# =============================================================================
# CCW-Online ERP - Staging Environment Configuration
# =============================================================================
# IMPORTANT: Copy this to .env.staging.local and configure with actual values
# DO NOT commit .env.staging.local to version control
# Last Updated: January 15, 2026
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=staging
DEBUG=false
PROJECT_NAME=CCW-Online ERP - Staging
LOG_LEVEL=INFO

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=ccw_staging
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=ccw_erp_staging
DATABASE_URL=postgresql+asyncpg://ccw_staging:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/ccw_erp_staging
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDIS CACHE & MESSAGE BROKER
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# CELERY TASK QUEUE
# =============================================================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=2

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
# Generate strong keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_JWT_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=http://localhost:3001,http://localhost:8001,https://staging.yourdomain.com

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8001
NEXT_TELEMETRY_DISABLED=1
FRONTEND_URL=http://localhost:3001

# =============================================================================
# AI PROVIDER (Choose: anthropic or ollama)
# =============================================================================
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api03-CHANGE_ME_STAGING_KEY

# Optional: Ollama for local AI testing
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI (if needed for fallback)
OPENAI_API_KEY=sk-test-CHANGE_ME_STAGING_KEY

# =============================================================================
# XERO INTEGRATION (Staging/Sandbox Credentials)
# =============================================================================
# Create staging app at: https://developer.xero.com/app/manage
XERO_CLIENT_ID_STAGING=CHANGE_ME_XERO_CLIENT_ID
XERO_CLIENT_SECRET_STAGING=CHANGE_ME_XERO_CLIENT_SECRET
XERO_REDIRECT_URI_STAGING=http://localhost:8001/api/integrations/xero/callback
XERO_SCOPES=offline_access accounting.transactions accounting.contacts

# =============================================================================
# SHOPIFY INTEGRATION (Development Store Credentials)
# =============================================================================
# Use test store at: https://partners.shopify.com/
SHOPIFY_SHOP_URL_STAGING=your-store-staging.myshopify.com
SHOPIFY_ACCESS_TOKEN_STAGING=shpat_CHANGE_ME_STAGING_TOKEN
SHOPIFY_API_VERSION=2024-01

# =============================================================================
# SENDGRID EMAIL (Staging Credentials)
# =============================================================================
# Create API key at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY_STAGING=SG.CHANGE_ME_STAGING_KEY
SENDGRID_FROM_EMAIL_STAGING=staging@yourdomain.com
SENDGRID_FROM_NAME_STAGING=CCW ERP Staging

# =============================================================================
# ELEVENLABS AI VOICE (Staging Credentials)
# =============================================================================
# Get API key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY_STAGING=CHANGE_ME_STAGING_KEY

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS=100
WEBSOCKET_MESSAGE_QUEUE_SIZE=1000

# =============================================================================
# MONITORING & OBSERVABILITY (Optional)
# =============================================================================
# Sentry for error tracking
SENTRY_DSN_STAGING=https://CHANGE_ME@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1

# Health check endpoints
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_TIMEOUT=5

# =============================================================================
# RATE LIMITING & PERFORMANCE
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# =============================================================================
# FILE STORAGE & UPLOADS
# =============================================================================
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png,csv,xlsx

# =============================================================================
# FEATURE FLAGS (Staging-specific)
# =============================================================================
FEATURE_REAL_TIME_UPDATES=true
FEATURE_AI_AGENTS=true
FEATURE_XERO_SYNC=true
FEATURE_SHOPIFY_SYNC=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_VOICE_ALERTS=false

# =============================================================================
# TESTING & QA
# =============================================================================
ENABLE_TEST_ENDPOINTS=true
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILING=false

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to staging:
# [ ] Replace all CHANGE_ME values with actual credentials
# [ ] Generate strong SECRET_KEY and JWT_SECRET_KEY
# [ ] Configure staging integration credentials (Xero, Shopify, SendGrid, ElevenLabs)
# [ ] Test database connection
# [ ] Test Redis connection
# [ ] Run health checks: curl http://localhost:8001/health
# [ ] Run integration tests: bash integration-tests.sh
# [ ] Verify all 39 tests pass (100% pass rate)
# [ ] Test frontend: curl http://localhost:3001
# [ ] Review logs for errors
# [ ] Test AI agent responses
# [ ] Test integration webhooks
# [ ] Load test with realistic traffic
# [ ] Backup database before deploying new changes
