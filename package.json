    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@lhci/cli": "^0.15.1",
    "@percy/playwright": "^1.0.10",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
