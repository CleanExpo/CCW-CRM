  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "sharp": "0.35.3"
  },
  "vitest": {
    "test": {
      "environment": "jsdom",
      "globals": true,
      "exclude": [
        "**/node_modules/**",
        "**/dist/**",
        "**/.next/**",
        "**/e2e/**",
        "**/CCW-CRM/**"
      ]
    }
  },
  "engines": {
    "node": "22.x",
    "npm": "11.x"
  }
}
