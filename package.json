{
  "name": "ccw-online-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Equipment Supplier ERP System built with Next.js and FastAPI",
  "author": "CCW",
  "license": "MIT",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "dev": "pnpm run -r --parallel --if-present dev",
    "build": "pnpm run -r --if-present build",
    "lint": "pnpm run -r --if-present lint",
    "type-check": "pnpm run -r --if-present type-check",
    "test": "pnpm run -r --if-present test",
    "test:coverage": "pnpm run -r --if-present test:coverage",
    "check": "pnpm run type-check && pnpm run lint",
    "check:all": "pnpm run type-check && pnpm run lint && pnpm run test",
    "clean": "pnpm run -r --if-present clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "verify": "bash scripts/verify.sh",
    "deps:check": "pnpm install --frozen-lockfile",
    "deps:clean": "pnpm prune && pnpm install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint-formatter-compact": "^9.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@composio/core": "^0.6.3",
    "@composio/openai-agents": "^0.6.3",
    "@openai/agents": "^0.4.10",
    "dotenv": "^17.3.1",
    "mcp-linear": "^0.1.8"
  }
}
