    "autoprefixer": "^10.4.20",
    "axe-core": "^4.11.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.0",
    "eslint-formatter-compact": "^9.0.1",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "minimatch": "^10.0.1",
    "postcss": "^8.5.14",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rollup": "^4.20.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
