/// Customer-owned equipment (field service / workshop registry).
model WorkshopEquipment {
  id               String    @id @default(uuid()) @db.Uuid
  ownerUserId      String    @map("owner_user_id") @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  productId        String?   @map("product_id") @db.Uuid
  serialNumber     String    @map("serial_number")
  make             String
  model            String
  year             Int?
  location         String
  purchaseDate     DateTime? @map("purchase_date") @db.Date
  warrantyExpiry   DateTime? @map("warranty_expiry") @db.Date
  status           String    @default("active")
  intervalMonths   Int?      @map("interval_months")
  intervalHours    Int?      @map("interval_hours")
  currentHours     Int       @default(0) @map("current_hours")
  lastServiceDate  DateTime? @map("last_service_date") @db.Date
  lastServiceHours Int?      @map("last_service_hours")
  nextServiceDate  DateTime? @map("next_service_date") @db.Date
  nextServiceHours Int?      @map("next_service_hours")
  reminderLeadDays Int       @default(14) @map("reminder_lead_days")
  notes            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  customer  Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product   Product?                  @relation(fields: [productId], references: [id], onDelete: SetNull)
  bookings  WorkshopBooking[]
  reminders WorkshopServiceReminder[]

  @@index([ownerUserId])
  @@index([customerId])
  @@index([location])
  @@index([status])
  @@map("workshop_equipment")
}

