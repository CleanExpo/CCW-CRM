model TradeFinanceLetterOfCredit {
  id                    String   @id @default(uuid()) @db.Uuid
  ownerUserId           String   @map("owner_user_id") @db.Uuid
  facilityId            String?  @map("facility_id") @db.Uuid
  lcNumber              String   @map("lc_number")
  bankRef               String?  @map("bank_ref")
  beneficiarySupplierId String?  @map("beneficiary_supplier_id") @db.Uuid
  purchaseOrderId       String?  @map("purchase_order_id") @db.Uuid
  amount                Float
  currency              String   @default("AUD")
  lcType                String   @default("usance") @map("lc_type")
  issueDate             DateTime @map("issue_date") @db.Date
  expiryDate            DateTime @map("expiry_date") @db.Date
  status                String   @default("issued")
  notes                 String?  @db.Text
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  facility      TradeFinanceFacility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  beneficiary   Supplier?             @relation(fields: [beneficiarySupplierId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  documents     TradeFinanceLcDocument[]
  amendments    TradeFinanceLcAmendment[]
  advances      TradeFinanceAdvance[]

  @@unique([ownerUserId, lcNumber])
  @@index([ownerUserId])
  @@index([status])
  @@index([expiryDate])
  @@map("trade_finance_letters_of_credit")
}

model TradeFinanceLcDocument {
  id          String    @id @default(uuid()) @db.Uuid
