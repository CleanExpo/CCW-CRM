model TradeFinanceAdvance {
  id              String   @id @default(uuid()) @db.Uuid
  facilityId      String   @map("facility_id") @db.Uuid
  ownerUserId     String   @map("owner_user_id") @db.Uuid
  lcId            String?  @map("lc_id") @db.Uuid
  advanceNumber   String   @map("advance_number")
  supplierId      String?  @map("supplier_id") @db.Uuid
  purchaseOrderId String?  @map("purchase_order_id") @db.Uuid
  drawdownDate    DateTime @map("drawdown_date") @db.Date
  maturityDate    DateTime @map("maturity_date") @db.Date
  currency        String   @default("AUD")
  principalAmount Float    @map("principal_amount")
  fees            Float    @default(0)
  interest        Float    @default(0)
  repaidAmount    Float    @default(0) @map("repaid_amount")
  securityRef     String?  @map("security_ref")
  status          String   @default("drawn")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  facility       TradeFinanceFacility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  letterOfCredit TradeFinanceLetterOfCredit? @relation(fields: [lcId], references: [id], onDelete: SetNull)
  supplier       Supplier?                   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder  PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  repayments     TradeFinanceRepayment[]
  bankFeedMatches BankFeedTransaction[]

  @@unique([ownerUserId, advanceNumber])
  @@index([facilityId])
  @@index([lcId])
  @@index([status])
  @@index([maturityDate])
  @@map("trade_finance_advances")
}

model TradeFinanceRepayment {
