  createdAt         DateTime @default(now()) @map("created_at")

  feedTransaction BankFeedTransaction @relation(fields: [feedTransactionId], references: [id], onDelete: Cascade)

  @@index([feedTransactionId])
  @@map("bank_reconciliation_allocations")
}

model BankReconciliationAudit {
  id                String   @id @default(uuid()) @db.Uuid
  feedTransactionId String   @map("feed_transaction_id") @db.Uuid
  action            String
  performedBy       String   @map("performed_by") @db.Uuid
