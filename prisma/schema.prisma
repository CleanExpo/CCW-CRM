generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  owner
  admin
  member
  billing
}

model AppUser {
  id                     String    @id @default(uuid()) @db.Uuid
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  fullName               String?   @map("full_name")
  role                   TeamRole  @default(member)
  isAdmin                Boolean   @default(false) @map("is_admin")
  isActive               Boolean   @default(true) @map("is_active")
  /// All users in one org share the same workspace id (typically the first owner’s user id).
  workspaceId            String    @map("workspace_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  lastLoginAt            DateTime? @map("last_login_at")
  passwordResetTokenHash String?   @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  @@index([workspaceId])
  @@map("app_users")
}

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  ownerUserId   String   @map("owner_user_id") @db.Uuid
  /// Stable Cin7 Omni/Core contact identifier for idempotent sync (no duplicate imports).
  cin7ContactId String?  @map("cin7_contact_id")
  /// Cin7 contact type label (Customer, Internal, etc.).
  cin7ContactType String? @map("cin7_contact_type")
  companyName   String   @map("company_name")
  contactName   String?  @map("contact_name")
  email         String?
  phone         String?
  city          String?
  isActive      Boolean  @default(true) @map("is_active")
  /// Maximum outstanding balance allowed before new orders are blocked (AUD, null = no limit)
  creditLimitAUD  Decimal? @map("credit_limit_aud") @db.Decimal(12, 2)
  /// Days from due-date anchor until invoice is due
  creditTermsDays Int?     @map("credit_terms_days")
  /// How the due date is anchored: NET = invoiceDate+days; EOM = end-of-invoice-month+days
  creditTermsType String?  @map("credit_terms_type")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orders                   Order[]
  quotes                   Quote[]
  invoices                 Invoice[]
  persona                  CustomerPersona?
  contacts                 CrmContact[]
  activities               CrmActivity[]
  workshopEquipment        WorkshopEquipment[]
  workshopServiceReminders WorkshopServiceReminder[]
  emailThreads             EmailThread[]
  operationalEvents        OperationalEvent[]
  priceTier                CustomerPriceTier?

  @@unique([ownerUserId, cin7ContactId])
  @@index([ownerUserId])
  @@index([ownerUserId, cin7ContactId])
  @@map("customers")
}

/// People at customer accounts (modern CRM contact records, workspace-scoped).
model CrmContact {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @map("owner_user_id") @db.Uuid
  customerId  String?  @map("customer_id") @db.Uuid
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  email       String?
  phone       String?
  mobile      String?
  jobTitle    String?  @map("job_title")
  department  String?
  isPrimary   Boolean  @default(false) @map("is_primary")
  isActive    Boolean  @default(true) @map("is_active")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  activities CrmActivity[]

  @@index([ownerUserId])
  @@index([customerId])
  @@index([email])
  @@map("crm_contacts")
}

/// Customer interaction log (calls, tasks, etc.) — links customer and/or contact.
model CrmActivity {
  id           String    @id @default(uuid()) @db.Uuid
  ownerUserId  String    @map("owner_user_id") @db.Uuid
  activityType String    @map("activity_type")
  subject      String
  description  String?   @db.Text
  customerId   String?   @map("customer_id") @db.Uuid
  contactId    String?   @map("contact_id") @db.Uuid
  orderId      String?   @map("order_id") @db.Uuid
  quoteId      String?   @map("quote_id") @db.Uuid
  dueDate      DateTime? @map("due_date")
  completedAt  DateTime? @map("completed_at")
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact  CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  order    Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  quote    Quote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([customerId])
  @@index([contactId])
  @@index([activityType])
  @@index([dueDate])
  @@map("crm_activities")
}

model CustomerPersona {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @unique @map("customer_id") @db.Uuid
  persona      String
  confidence   String
  reason       String
  classifiedAt DateTime @default(now()) @map("classified_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([persona])
  @@map("customer_personas")
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  ownerUserId       String   @map("owner_user_id") @db.Uuid
  name              String
  sku               String
  category          String?
  price             Float    @default(0)
  stock             Int      @default(0)
  isActive          Boolean  @default(true) @map("is_active")
  warehouseLocation String?  @map("warehouse_location")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  orderLineItems               OrderLineItem[]
  purchaseOrderLines           PurchaseOrderLine[]
  quoteLineItems               QuoteLineItem[]
  posTransactionLines          PosTransactionLine[]
  goodsReceiptLines            GoodsReceiptLine[]
  invoiceLineItems             InvoiceLineItem[]
  locationStocks               ProductLocationStock[]
  stockTransfers               StockTransfer[]
  stockReservations            StockReservation[]
  inventoryStockTakeLines      InventoryStockTakeLine[]
  workshopEquipment            WorkshopEquipment[]
  workshopServiceTemplateItems WorkshopServiceTemplateItem[]
  sds                          ProductSds?

  @@unique([ownerUserId, sku])
  @@index([ownerUserId])
  @@map("products")
}

model ProductSds {
  id                       String    @id @default(uuid()) @db.Uuid
  productId                String    @unique @map("product_id") @db.Uuid
  sdsPdfUrl                String?   @map("sds_pdf_url") @db.Text
  ghsSignalWord            String?   @map("ghs_signal_word")
  /// GHS hazard statement codes, e.g. ["H225","H302"]
  hazardStatements         Json      @default("[]") @map("hazard_statements")
  revisionDate             DateTime? @map("revision_date") @db.Date
  reviewDueDate            DateTime? @map("review_due_date") @db.Date
  supplierEmergencyContact String?   @map("supplier_emergency_contact") @db.Text
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([reviewDueDate])
  @@map("product_sds")
}

model Cin7BomMaster {
  id               String    @id @default(uuid()) @db.Uuid
  ownerUserId      String    @map("owner_user_id") @db.Uuid
  cin7BomId        String    @map("cin7_bom_id")
  name             String
  sku              String
  version          String    @default("1")
  status           String    @default("active")
  finishedGoodSku  String?   @map("finished_good_sku")
  finishedGoodName String?   @map("finished_good_name")
  quantityProduced String    @default("1.0000") @map("quantity_produced")
  uom              String    @default("EA")
  notes            String?
  lastSyncedAt     DateTime? @map("last_synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  components     Cin7BomComponent[]
  productionRuns Cin7ProductionRun[]

  @@unique([ownerUserId, cin7BomId])
  @@index([ownerUserId])
  @@map("cin7_bom_masters")
}

model Cin7BomComponent {
  id             String  @id @default(uuid()) @db.Uuid
  bomMasterId    String  @map("bom_master_id") @db.Uuid
  componentSku   String  @map("component_sku")
  componentName  String  @map("component_name")
  quantity       String  @default("1.0000")
  uom            String  @default("EA")
  wastagePercent String  @default("0.00") @map("wastage_percent")
  notes          String?

  bomMaster Cin7BomMaster @relation(fields: [bomMasterId], references: [id], onDelete: Cascade)

  @@index([bomMasterId])
  @@map("cin7_bom_components")
}

model Cin7ProductionRun {
  id                String    @id @default(uuid()) @db.Uuid
  ownerUserId       String    @map("owner_user_id") @db.Uuid
  bomMasterId       String    @map("bom_master_id") @db.Uuid
  cin7ProductionId  String?   @map("cin7_production_id")
  quantityPlanned   String    @map("quantity_planned")
  quantityCompleted String    @default("0") @map("quantity_completed")
  status            String    @default("planned")
  plannedDate       DateTime? @map("planned_date")
  completedDate     DateTime? @map("completed_date")
  locationId        String?   @map("location_id")
  notes             String?
  cin7Synced        Boolean   @default(false) @map("cin7_synced")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  bomMaster Cin7BomMaster @relation(fields: [bomMasterId], references: [id], onDelete: Restrict)

  @@index([ownerUserId])
  @@index([bomMasterId])
  @@map("cin7_production_runs")
}

model ProductLocationStock {
  id                  String   @id @default(uuid()) @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  location            String
  quantity            Int      @default(0)
  reserved            Int      @default(0)
  reorderPoint        Int?     @map("reorder_point")
  reorderQuantity     Int?     @map("reorder_quantity")
  leadTimeDays        Int      @default(7) @map("lead_time_days")
  autoApproveUnderQty Int      @default(0) @map("auto_approve_under_qty")
  reorderEnabled      Boolean  @default(true) @map("reorder_enabled")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, location])
  @@index([productId])
  @@map("product_location_stock")
}

model StockReservation {
  id          String    @id @default(uuid()) @db.Uuid
  ownerUserId String    @map("owner_user_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  orderId     String    @map("order_id")
  location    String
  quantity    Int
  status      String    @default("active")
  reservedAt  DateTime  @default(now()) @map("reserved_at")
  expiresAt   DateTime? @map("expires_at")
  fulfilledAt DateTime? @map("fulfilled_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([productId])
  @@index([status])
  @@map("stock_reservations")
}

model InventoryStockTake {
  id          String    @id @default(uuid()) @db.Uuid
  ownerUserId String    @map("owner_user_id") @db.Uuid
  location    String
  status      String    @default("in_progress")
  createdAt   DateTime  @default(now()) @map("created_at")
  submittedAt DateTime? @map("submitted_at")

  lines InventoryStockTakeLine[]

  @@index([ownerUserId])
  @@map("inventory_stock_takes")
}

model InventoryStockTakeLine {
  id         String @id @default(uuid()) @db.Uuid
  takeId     String @map("take_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  countedQty Int    @map("counted_qty")

  take    InventoryStockTake @relation(fields: [takeId], references: [id], onDelete: Cascade)
  product Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([takeId, productId])
  @@index([takeId])
  @@map("inventory_stock_take_lines")
}

model StockTransfer {
  id           String   @id @default(uuid()) @db.Uuid
  ownerUserId  String   @map("owner_user_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  fromLocation String   @map("from_location")
  toLocation   String   @map("to_location")
  quantity     Int
  status       String   @default("completed")
  reason       String?
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([productId])
  @@map("stock_transfers")
}

model Order {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @map("owner_user_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  orderNumber String   @map("order_number")
  status      String
  total       Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lineItems     OrderLineItem[]
  invoices      Invoice[]
  crmActivities CrmActivity[]

  @@index([ownerUserId])
  @@map("orders")
}

model OrderLineItem {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @map("order_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Float  @map("unit_price")
  lineTotal Float  @map("line_total")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_line_items")
}

model Quote {
  id          String    @id @default(uuid()) @db.Uuid
  ownerUserId String    @map("owner_user_id") @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  quoteNumber String    @map("quote_number")
  status      String
  total       Float?
  validUntil  DateTime? @map("valid_until")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lineItems     QuoteLineItem[]
  crmActivities CrmActivity[]

  @@index([ownerUserId])
  @@map("quotes")
}

model QuoteLineItem {
  id        String @id @default(uuid()) @db.Uuid
  quoteId   String @map("quote_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Float  @map("unit_price")
  lineTotal Float  @map("line_total")

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quoteId])
  @@map("quote_line_items")
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  ownerUserId   String   @map("owner_user_id") @db.Uuid
  invoiceNumber String   @map("invoice_number")
  customerId    String   @map("customer_id") @db.Uuid
  orderId       String?  @map("order_id") @db.Uuid
  invoiceDate   DateTime @map("invoice_date") @db.Date
  dueDate       DateTime @map("due_date") @db.Date
  status        String   @default("draft")
  notes         String?
  subtotal      Float    @default(0)
  taxTotal      Float    @default(0) @map("tax_total")
  total         Float    @default(0)
  amountPaid    Float    @default(0) @map("amount_paid")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer         Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order            Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items            InvoiceLineItem[]
  payments         InvoicePayment[]
  bankFeedMatches  BankFeedTransaction[]

  @@unique([ownerUserId, invoiceNumber])
  @@index([ownerUserId])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceLineItem {
  id           String   @id @default(uuid()) @db.Uuid
  invoiceId    String   @map("invoice_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  description  String
  quantity     Int
  unitPrice    Float    @map("unit_price")
  taxRate      Float    @default(0) @map("tax_rate")
  taxAmount    Float    @default(0) @map("tax_amount")
  lineSubtotal Float    @default(0) @map("line_subtotal")
  lineTotal    Float    @default(0) @map("line_total")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model InvoicePayment {
  id              String   @id @default(uuid()) @db.Uuid
  invoiceId       String   @map("invoice_id") @db.Uuid
  amount          Float
  paymentDate     DateTime @map("payment_date") @db.Date
  paymentMethod   String   @map("payment_method")
  referenceNumber String?  @map("reference_number")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_payments")
}

model EmailThread {
  id            String   @id @default(uuid()) @db.Uuid
  ownerUserId   String   @map("owner_user_id") @db.Uuid
  customerId    String?  @map("customer_id") @db.Uuid
  subject       String
  customerEmail String   @map("customer_email")
  customerName  String?  @map("customer_name")
  status        String   @default("open")
  intent        String?
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages EmailMessage[]

  @@index([ownerUserId])
  @@index([customerId])
  @@index([customerEmail])
  @@map("email_threads")
}

model EmailMessage {
  id                String    @id @default(uuid()) @db.Uuid
  threadId          String    @map("thread_id") @db.Uuid
  direction         String
  fromEmail         String    @map("from_email")
  toEmail           String    @map("to_email")
  subject           String
  bodyText          String    @map("body_text")
  bodyHtml          String?   @map("body_html")
  sendgridMessageId String?   @map("sendgrid_message_id")
  deliveryStatus    String?   @default("pending") @map("delivery_status")
  deliveryDetail    String?   @map("delivery_detail")
  lastEventAt       DateTime? @map("last_event_at")
  sentAt            DateTime  @default(now()) @map("sent_at")
  wasAiGenerated    Boolean   @default(false) @map("was_ai_generated")

  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([sendgridMessageId])
  @@map("email_messages")
}

model Supplier {
  id           String   @id @default(uuid()) @db.Uuid
  ownerUserId  String   @map("owner_user_id") @db.Uuid
  supplierCode String   @map("supplier_code")
  companyName  String   @map("company_name")
  contactName  String?  @map("contact_name")
  email        String?
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  purchaseOrders       PurchaseOrder[]
  tradeFinanceAdvances TradeFinanceAdvance[]
  tradeFinanceLcs      TradeFinanceLetterOfCredit[]

  @@unique([ownerUserId, supplierCode])
  @@index([ownerUserId])
  @@map("suppliers")
}

/// Cin7 Omni branch / location master data (warehouse sites).
model Cin7Branch {
  id           String   @id @default(uuid()) @db.Uuid
  ownerUserId  String   @map("owner_user_id") @db.Uuid
  cin7BranchId String   @map("cin7_branch_id")
  name         String
  branchType   String?  @map("branch_type")
  email        String?
  phone        String?
  city         String?
  state        String?
  postCode     String?  @map("post_code")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, cin7BranchId])
  @@index([ownerUserId])
  @@map("cin7_branches")
}

/// Audit trail for manual and scheduled Cin7 sync runs.
model Cin7SyncRun {
  id               String   @id @default(uuid()) @db.Uuid
  ownerUserId      String   @map("owner_user_id") @db.Uuid
  entityType       String   @map("entity_type")
  recordsProcessed Int      @map("records_processed")
  skipped          Json?
  durationMs       Int      @map("duration_ms")
  source           String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([ownerUserId, createdAt(sort: Desc)])
  @@map("cin7_sync_runs")
}

model PurchaseOrder {
  id                   String    @id @default(uuid()) @db.Uuid
  ownerUserId          String    @map("owner_user_id") @db.Uuid
  poNumber             String    @map("po_number")
  supplierId           String    @map("supplier_id") @db.Uuid
  deliveryLocation     String    @map("delivery_location")
  status               String
  orderDate            DateTime  @default(now()) @map("order_date")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  actualDeliveryDate   DateTime? @map("actual_delivery_date")
  subtotal             Float     @default(0)
  tax                  Float     @default(0)
  shippingCost         Float?    @map("shipping_cost")
  total                Float     @default(0)
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines                PurchaseOrderLine[]
  bankFeedMatches      BankFeedTransaction[]
  tradeFinanceAdvances TradeFinanceAdvance[]
  tradeFinanceLcs      TradeFinanceLetterOfCredit[]

  @@unique([ownerUserId, poNumber])
  @@index([ownerUserId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String @id @default(uuid()) @db.Uuid
  purchaseOrderId  String @map("purchase_order_id") @db.Uuid
  productId        String @map("product_id") @db.Uuid
  quantity         Int
  quantityReceived Int    @default(0) @map("quantity_received")
  unitCost         Float  @map("unit_cost")
  subtotal         Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

model PosTransaction {
  id                   String   @id @default(uuid()) @db.Uuid
  ownerUserId          String?  @map("owner_user_id") @db.Uuid
  transactionNumber    String   @unique @map("transaction_number")
  terminalId           String   @map("terminal_id")
  locationCode         String   @map("location_code")
  salesStaffId         String?  @map("sales_staff_id")
  paymentMethod        String   @map("payment_method")
  paymentStatus        String   @map("payment_status")
  subtotal             Float
  tax                  Float
  amount               Float
  reconciliationStatus String   @default("pending") @map("reconciliation_status")
  createdAt            DateTime @default(now()) @map("created_at")

  lines PosTransactionLine[]

  @@index([ownerUserId])
  @@index([reconciliationStatus])
  @@map("pos_transactions")
}

model PosTransactionLine {
  id               String @id @default(uuid()) @db.Uuid
  posTransactionId String @map("pos_transaction_id") @db.Uuid
  productId        String @map("product_id") @db.Uuid
  quantity         Int
  unitPrice        Float  @map("unit_price")
  lineTotal        Float  @map("line_total")

  posTransaction PosTransaction @relation(fields: [posTransactionId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([posTransactionId])
  @@map("pos_transaction_lines")
}

model BankAccount {
  id             String    @id @default(uuid()) @db.Uuid
  ownerUserId    String?   @map("owner_user_id") @db.Uuid
  accountName    String    @map("account_name")
  accountNumber  String    @map("account_number")
  bsb            String
  bankName       String    @map("bank_name")
  accountType    String    @map("account_type")
  feedProvider   String    @map("feed_provider")
  currency       String    @default("AUD")
  cdrAccountId   String?   @map("cdr_account_id")
  lastFeedSyncAt DateTime? @map("last_feed_sync_at")
  isActive       Boolean   @default(true) @map("is_active")
  locationCode   String?   @map("location_code")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  feedTransactions BankFeedTransaction[]

  @@index([ownerUserId])
  @@map("bank_accounts")
}

model BankFeedTransaction {
  id                     String    @id @default(uuid()) @db.Uuid
  bankAccountId          String    @map("bank_account_id") @db.Uuid
  transactionDate        DateTime  @map("transaction_date")
  description            String
  rawNarration           String?   @map("raw_narration") @db.Text
  reference              String    @default("")
  credit                 Float?
  debit                  Float?
  balance                Float?
  reconciled             Boolean   @default(false)
  status                 String    @default("unmatched")
  reviewStatus           String?   @map("review_status")
  suggestedAction        String?   @map("suggested_action")
  confidenceScore        Float?    @map("confidence_score")
  confidenceReason       String?   @map("confidence_reason") @db.Text
  matchedPosTxId         String?   @map("matched_pos_tx_id") @db.Uuid
  matchedInvoiceId       String?   @map("matched_invoice_id") @db.Uuid
  matchedPurchaseOrderId String?   @map("matched_purchase_order_id") @db.Uuid
  matchedAdvanceId       String?   @map("matched_advance_id") @db.Uuid
  gstCategory            String?   @map("gst_category")
  accountCategory        String?   @map("account_category")
  reconciledBy           String?   @map("reconciled_by") @db.Uuid
  reconciledAt           DateTime? @map("reconciled_at")
  xeroExportStatus       String?   @map("xero_export_status")
  xeroExportRef          String?   @map("xero_export_ref")
  externalFeedId         String?   @map("external_feed_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  bankAccount          BankAccount                    @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  matchedInvoice       Invoice?                       @relation(fields: [matchedInvoiceId], references: [id], onDelete: SetNull)
  matchedPurchaseOrder PurchaseOrder?                 @relation(fields: [matchedPurchaseOrderId], references: [id], onDelete: SetNull)
  matchedAdvance       TradeFinanceAdvance?           @relation(fields: [matchedAdvanceId], references: [id], onDelete: SetNull)
  allocations          BankReconciliationAllocation[]
  auditEntries         BankReconciliationAudit[]

  @@unique([bankAccountId, externalFeedId])
  @@index([bankAccountId])
  @@index([reconciled])
  @@index([status])
  @@index([matchedInvoiceId])
  @@index([matchedAdvanceId])
  @@map("bank_feed_transactions")
}

model BankReconciliationAllocation {
  id                String   @id @default(uuid()) @db.Uuid
  feedTransactionId String   @map("feed_transaction_id") @db.Uuid
  allocationType    String   @map("allocation_type")
