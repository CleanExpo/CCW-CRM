  confidenceScore Float?   @map("confidence_score")
  humanReviewerId String?  @map("human_reviewer_id") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  callSession CcwAiCallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)

  @@index([decision])
  @@map("ccw_ai_call_triage_decisions")
}

model CcwAiConversationInsight {
  id            String   @id @default(uuid()) @db.Uuid
  ownerUserId   String   @map("owner_user_id") @db.Uuid
  callSessionId String?  @map("call_session_id") @db.Uuid
  insightType   String   @map("insight_type")
  label         String
  detail        String   @db.Text
  evidence      Json     @default("{}")
  status        String   @default("new")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  callSession CcwAiCallSession? @relation(fields: [callSessionId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([callSessionId])
  @@index([insightType])
  @@index([status])
  @@map("ccw_ai_conversation_insights")
}

model CcwSpecializedAgent {
  id              String   @id @default(uuid()) @db.Uuid
  ownerUserId     String   @map("owner_user_id") @db.Uuid
  agentCode       String   @map("agent_code")
  name            String
  purpose         String   @db.Text
  persona         Json     @default("{}")
  playbook        Json     @default("{}")
  status          String   @default("draft")
  requiresApproval Boolean @default(true) @map("requires_approval")
  approvedBy      String?  @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  learningItems CcwAgentLearning[]
  followUpRules CcwFollowUpRule[]

  @@unique([ownerUserId, agentCode])
  @@index([ownerUserId])
  @@index([status])
  @@map("ccw_specialized_agents")
}

model CcwAgentLearning {
  id              String   @id @default(uuid()) @db.Uuid
  agentId         String   @map("agent_id") @db.Uuid
  sourceType      String   @map("source_type")
  sourceId        String?  @map("source_id") @db.Uuid
  lesson          String   @db.Text
  confidenceScore Float?   @map("confidence_score")
  status          String   @default("pending_review")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  agent CcwSpecializedAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([sourceType])
  @@index([status])
  @@map("ccw_agent_learning")
}

model CcwFollowUpRule {
  id             String   @id @default(uuid()) @db.Uuid
  ownerUserId    String   @map("owner_user_id") @db.Uuid
  agentId        String?  @map("agent_id") @db.Uuid
  ruleType       String   @map("rule_type")
  name           String
  triggerConfig  Json     @default("{}") @map("trigger_config")
  channelConfig  Json     @default("{}") @map("channel_config")
  status         String   @default("draft")
  requiresApproval Boolean @default(true) @map("requires_approval")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  agent   CcwSpecializedAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  actions CcwFollowUpAction[]

  @@index([ownerUserId])
  @@index([agentId])
  @@index([ruleType])
  @@index([status])
  @@map("ccw_follow_up_rules")
}

model CcwFollowUpAction {
  id            String    @id @default(uuid()) @db.Uuid
  ownerUserId   String    @map("owner_user_id") @db.Uuid
  ruleId        String?   @map("rule_id") @db.Uuid
  callSessionId String?   @map("call_session_id") @db.Uuid
  actionType    String    @map("action_type")
  channel       String
  status        String    @default("draft")
  recipientRef  String?   @map("recipient_ref")
  subject       String?
  body          String?   @db.Text
  payload       Json      @default("{}")
  scheduledFor  DateTime? @map("scheduled_for")
  approvedBy    String?   @map("approved_by") @db.Uuid
  approvedAt    DateTime? @map("approved_at")
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  rule        CcwFollowUpRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  callSession CcwAiCallSession? @relation(fields: [callSessionId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([ruleId])
  @@index([callSessionId])
  @@index([actionType])
  @@index([status])
  @@index([scheduledFor])
  @@map("ccw_follow_up_actions")
}

model CcwIndustryEvent {
