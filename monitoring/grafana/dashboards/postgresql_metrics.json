{
  "title": "PostgreSQL Metrics",
  "uid": "postgresql-metrics",
  "tags": ["infrastructure", "postgresql"],
  "timezone": "",
  "schemaVersion": 38,
  "version": 0,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "PostgreSQL Status",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "up{job=\"postgres\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 0},
              {"color": "green", "value": 1}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Database Connections",
      "gridPos": {"h": 8, "w": 8, "x": 4, "y": 0},
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count)",
          "legendFormat": "Active Connections",
          "refId": "A"
        },
        {
          "expr": "pg_settings_max_connections",
          "legendFormat": "Max Connections",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Transaction Rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=~\"starter_db\"}[5m])",
          "legendFormat": "Commits/sec",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=~\"starter_db\"}[5m])",
          "legendFormat": "Rollbacks/sec",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Database Size",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 4},
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"starter_db\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5368709120},
              {"color": "red", "value": 10737418240}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Row Operations",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_inserted{datname=\"starter_db\"}[5m])",
          "legendFormat": "Inserts/sec",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_tup_updated{datname=\"starter_db\"}[5m])",
          "legendFormat": "Updates/sec",
          "refId": "B"
        },
        {
          "expr": "rate(pg_stat_database_tup_deleted{datname=\"starter_db\"}[5m])",
          "legendFormat": "Deletes/sec",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Database Locks",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "pg_locks_count",
          "legendFormat": "Active Locks",
          "refId": "A"
        }
      ]
    }
  ]
}
