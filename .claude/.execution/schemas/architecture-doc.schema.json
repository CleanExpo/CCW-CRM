{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ccw-online-erp/schemas/architecture-doc.schema.json",
  "title": "Architecture Document",
  "description": "Schema for Phase 2 architecture output",
  "type": "object",
  "required": ["task_id", "timestamp", "design_summary", "components", "implementation_plan"],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "design_summary": {
      "type": "string",
      "description": "High-level overview of the solution"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "file_path"],
        "properties": {
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["frontend_component", "backend_endpoint", "utility", "test", "documentation"]
          },
          "file_path": { "type": "string" },
          "purpose": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "imports": { "type": "array", "items": { "type": "string" } },
          "exports": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "implementation_plan": {
      "type": "object",
      "properties": {
        "files_to_create": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "purpose": { "type": "string" },
              "template": { "type": "string" },
              "priority": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "files_to_modify": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "changes": { "type": "string" },
              "priority": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "estimated_time_minutes": { "type": "integer" }
      }
    },
    "breaking_changes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Any breaking changes identified"
    },
    "approval_required": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Items that need user approval before proceeding"
    }
  }
}
