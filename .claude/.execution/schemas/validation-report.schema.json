{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ccw-online-erp/schemas/validation-report.schema.json",
  "title": "Validation Report",
  "description": "Schema for validation-reports/*.json - validator agent output",
  "type": "object",
  "required": [
    "phase",
    "agent",
    "timestamp",
    "checks_performed",
    "overall_status",
    "recommendation"
  ],
  "properties": {
    "phase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Phase being validated"
    },
    "agent": {
      "type": "string",
      "const": "validator",
      "description": "Always 'validator'"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When validation was performed"
    },
    "checks_performed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_name", "status", "message"],
        "properties": {
          "check_name": {
            "type": "string",
            "description": "Name of the validation check",
            "examples": [
              "discovery_completeness",
              "architecture_follows_patterns",
              "no_database_schema_changes",
              "typescript_compiles",
              "tests_passing"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "warning"],
            "description": "Check result"
          },
          "message": {
            "type": "string",
            "description": "Human-readable result message"
          },
          "details": {
            "type": "object",
            "description": "Additional details about the check"
          }
        }
      }
    },
    "overall_status": {
      "type": "string",
      "enum": ["pass", "fail", "pass_with_warnings"],
      "description": "Overall validation result"
    },
    "recommendation": {
      "type": "string",
      "enum": ["proceed", "retry", "escalate"],
      "description": "What should happen next"
    },
    "blocking_issues": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Issues that must be resolved before proceeding"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Non-blocking issues to be aware of"
    },
    "suggestions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional improvements"
    }
  }
}
