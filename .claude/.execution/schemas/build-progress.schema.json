{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ccw-online-erp/schemas/build-progress.schema.json",
  "title": "Build Progress",
  "description": "Schema for Phase 3 build progress tracking",
  "type": "object",
  "required": ["task_id", "timestamp", "status", "files_completed", "files_remaining"],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["in_progress", "completed", "blocked", "failed"]
    },
    "files_completed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "action": { "type": "string", "enum": ["created", "modified"] },
          "completed_at": { "type": "string", "format": "date-time" },
          "lines_added": { "type": "integer" },
          "lines_removed": { "type": "integer" }
        }
      }
    },
    "files_remaining": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "action": { "type": "string", "enum": ["create", "modify"] },
          "priority": { "type": "integer" }
        }
      }
    },
    "tests_written": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "test_count": { "type": "integer" },
          "passing": { "type": "boolean" }
        }
      }
    },
    "quality_checks": {
      "type": "object",
      "properties": {
        "typescript_compiles": { "type": "boolean" },
        "python_type_check": { "type": "boolean" },
        "lint_passing": { "type": "boolean" },
        "tests_passing": { "type": "boolean" },
        "test_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "suggested_resolution": { "type": "string" }
        }
      }
    },
    "elapsed_time_minutes": {
      "type": "integer"
    },
    "estimated_remaining_minutes": {
      "type": "integer"
    }
  }
}
