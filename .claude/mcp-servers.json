{
  "version": "1.0.0",
  "settings": {
    "toolSearch": {
      "enabled": true,
      "maxToolsInContext": 20
    }
  },
  "servers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@anthropics/mcp-server-filesystem", "--root", "."],
      "tools": {
        "deferLoading": false
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@anthropics/mcp-server-github"],
      "tools": {
        "deferLoading": true
      }
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@anthropics/mcp-server-postgres"],
      "tools": {
        "deferLoading": true
      }
    }
  }
}
