                  "text": "CLOSED"
                },
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "OPEN"
                },
                "2": {
                  "color": "yellow",
                  "index": 2,
                  "text": "HALF-OPEN"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
