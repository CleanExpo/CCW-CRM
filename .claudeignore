# CCW-Online ERP — Claude Code ignore list
# Soft exclusion: prevents implicit indexing/auto-loading.
# Claude can still Read these paths explicitly when a task requires it.
# Single biggest token saver in the optimization pack.

# ─── Build artifacts ────────────────────────────────────────
.next/
dist/
build/
out/
.output/
.nuxt/
.turbo/
.parcel-cache/
*.tsbuildinfo
*.min.js
*.min.css
*.bundle.js

# ─── Dependencies ───────────────────────────────────────────
node_modules/
apps/web/node_modules/
apps/backend/.venv/
apps/backend/venv/
**/__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Lock files (30 KB – 400 KB each, never useful for reasoning) ───
pnpm-lock.yaml
package-lock.json
yarn.lock
uv.lock
poetry.lock
Pipfile.lock
Gemfile.lock
Cargo.lock
composer.lock

# ─── Logs ───────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ─── Env / secrets (security + waste) ───────────────────────
.env
.env.*
*.pem
*.key
*.cert

# ─── Media (Claude cannot reason about binary content) ──────
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.ico
*.mp4
*.mov
*.webm
*.woff
*.woff2
*.ttf
*.eot
*.otf
*.pdf

# ─── Test output / snapshots / coverage ─────────────────────
coverage/
__snapshots__/
__fixtures__/
.nyc_output/
playwright-report/
test-results/

# ─── Generated source maps & types ──────────────────────────
*.js.map
*.css.map
*.d.ts.map
generated/
__generated__/

# ─── Local databases ────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Alembic compiled migrations ────────────────────────────
apps/backend/alembic/versions/*.pyc

# ─── OS / editor noise ──────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*.swo

# ─── Claude framework artifacts ─────────────────────────────
.claude/snapshots/
.claude/.execution
