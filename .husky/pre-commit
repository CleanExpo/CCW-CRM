#!/usr/bin/env sh

# Run lint-staged (format staged files)
pnpm exec lint-staged

# Check lockfile integrity when package.json or pnpm-lock.yaml are staged
STAGED_FILES=$(git diff --cached --name-only)
if echo "$STAGED_FILES" | grep -qE '(package\.json|pnpm-lock\.yaml)'; then
  echo "Lockfile-related files staged — verifying integrity..."
  bash scripts/dependency-checks.sh
fi

# Secret scanning — requires gitleaks (https://github.com/gitleaks/gitleaks)
# Install: brew install gitleaks  OR  winget install gitleaks
# To skip: SKIP_GITLEAKS=1 git commit
if [ -z "$SKIP_GITLEAKS" ] && command -v gitleaks >/dev/null 2>&1; then
  echo "Running gitleaks secret scan..."
  gitleaks protect --staged --no-banner
fi
