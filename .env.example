# =============================================================================
# CCW-Online ERP — single committed `.env` template (`/.env.example`)
#
# Copy variables into real env files (all gitignored except this one):
#   - Backend (FastAPI): `backend/.env`
#   - Frontend (Next.js): `apps/web/.env.local`
#   - Optional root `.env` if a tool expects it
#
# Sections marked "Former file:" were merged from removed template paths.
# =============================================================================

# ===========================================
# PROJECT CONFIGURATION
# ===========================================
PROJECT_NAME=my-project
NODE_ENV=development

# ===========================================
# DATABASE (PostgreSQL - Local by default)
# ===========================================
# Local PostgreSQL (matches docker-compose.yml — port 5434 maps to container 5432)
DATABASE_URL=postgresql://starter_user:local_dev_password@localhost:5434/starter_db

# For production, use your PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@host:5432/database

# ===========================================
# AUTHENTICATION (JWT)
# ===========================================
# IMPORTANT: Change this secret key in production!
JWT_SECRET_KEY=your-secret-key-change-in-production-use-long-random-string
JWT_EXPIRE_MINUTES=60

# ===========================================
# AI MODELS (All Optional - Ollama used by default)
# ===========================================
# AI Provider: "ollama" (local) or "anthropic" (cloud)
AI_PROVIDER=ollama

# Ollama Configuration (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Anthropic (Claude) - Optional cloud provider
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-opus-4-6
# ANTHROPIC_MAX_TOKENS=4096
# ANTHROPIC_TEMPERATURE=0.4

# Google (Gemini) - Optional
# GOOGLE_AI_API_KEY=xxx

# OpenRouter (Multi-model access) - Optional
# OPENROUTER_API_KEY=sk-or-xxx

# ===========================================
# LEGACY: SUPABASE (Deprecated - for migration only)
# ===========================================
# These are kept for backward compatibility during migration
# Will be removed in future versions
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_JWT_SECRET=your-jwt-secret

# ===========================================
# MCP TOOLS
# ===========================================
# Exa (Web Search)
EXA_API_KEY=xxx

# Ref.tools
REF_TOOLS_API_KEY=xxx

# ===========================================
# BACKEND
# ===========================================
BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=your-internal-api-key

# ===========================================
# FRONTEND
# ===========================================
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ===========================================
# SHOPIFY INTEGRATION
# ===========================================
# Mode: "demo" for testing without real API calls, "live" for production
SHOPIFY_MODE=demo

# Shopify store domain (e.g., your-store.myshopify.com)
SHOPIFY_SHOP_DOMAIN=demo-store.myshopify.com

# Admin API credentials (get from Shopify Admin > Settings > Apps and sales channels > Develop apps)
SHOPIFY_API_KEY=demo_api_key_12345
SHOPIFY_API_SECRET=demo_api_secret_67890
SHOPIFY_ACCESS_TOKEN=demo_access_token_abcdef

# API version (2024-01, 2024-04, 2024-07, etc.)
SHOPIFY_API_VERSION=2024-01

# Webhook secret (for verifying webhook signatures)
SHOPIFY_WEBHOOK_SECRET=demo_webhook_secret_xyz

# Inventory sync settings
SHOPIFY_SYNC_INVENTORY=true
SHOPIFY_INVENTORY_LOCATION_ID=

# OAuth (custom app): SHOPIFY_CLIENT_ID is the same “API key” shown in Shopify; SHOPIFY_API_SECRET is the client secret.
#SHOPIFY_CLIENT_ID=
# Whitelist in your Shopify app: {NEXT_PUBLIC_FRONTEND_URL}/api/integrations/shopify/callback
#SHOPIFY_REDIRECT_URI=http://localhost:3000/api/integrations/shopify/callback
# If you only have a public storefront domain in SHOPIFY_SHOP_DOMAIN, set the Admin API host here:
#SHOPIFY_MY_SHOPIFY_DOMAIN=your-store.myshopify.com
#SHOPIFY_SCOPES=read_products,write_products,read_orders,read_customers,read_inventory,write_inventory

# ===========================================
# CIN7 — Omni (primary) and Core (optional)
# ===========================================
# Live Cin7 is usually Cin7 Omni: API Username + Connection Key (read-only is fine for inbound sync).
CIN7_MODE=live
CIN7_OMNI_USERNAME=
# Connection key from Cin7 (same value as “API key” in older docs). Either variable works:
CIN7_OMNI_API_KEY=
#CIN7_OMNI_CONNECTION_KEY=
# Optional Cin7 Core / External API (not used when Omni-only):
CIN7_CORE_ACCOUNT_ID=
CIN7_CORE_APPLICATION_KEY=
# Optional (default: https://inventory.dearsystems.com/ExternalApi/v2)
#CIN7_CORE_API_BASE_URL=
# IPs to register in Cin7 as API connectors (defaults match StockTrim1 / Transfreight)
CIN7_CONNECTOR_STOCKTRIM_NAME=StockTrim1
CIN7_CONNECTOR_STOCKTRIM_IP=147.243.240.166
CIN7_CONNECTOR_TRANSFREIGHT_NAME=Transfreight
CIN7_CONNECTOR_TRANSFREIGHT_IP=147.243.252.247
# Max pages (100 records/page) for product/customer sync jobs
# 0 or all = sync all Cin7 pages until exhausted (safety cap ~100k records). Integer = max pages.
CIN7_SYNC_MAX_PAGES=0
# Prefer omni when both Cin7 Core and Omni credentials are configured (omni|core).
CIN7_SYNC_PREFER=omni
# API page size (50–250; 250 = fastest for Cin7 Omni).
CIN7_SYNC_PAGE_SIZE=250
# Rows per processing chunk (default 20 — safe for remote managed Postgres).
CIN7_SYNC_DB_BATCH=20
# Parallel upserts per chunk (default 10; raise only if DB connection limit allows).
CIN7_SYNC_DB_CONCURRENCY=10
# Gap between Cin7 catalog API pages (ms) — avoids rate limits during full sync/reconciliation
CIN7_CATALOG_PAGE_GAP_MS=300
# Gap between entity catalog fetches during reconciliation (ms)
CIN7_CATALOG_ENTITY_GAP_MS=1500
# Stop each sync request before serverless maxDuration (ms); client auto-resumes via start_page
CIN7_SYNC_TIME_BUDGET_MS=280000
# Must stay unset/false until go-live — blocks Cin7 customer duplicate cleanup (Phase 1: no merge/delete/cleanse)
#CIN7_ALLOW_DUPLICATE_CLEANUP=false
# Server Cin7 sequential sync: 5:00 AM and 9:00 PM Australia/Sydney.
# `npm run dev` always fires the first run 5 minutes after boot.
# CIN7_SYNC_TEST_DELAY=true

# ===========================================
# COMPOSIO (AI Agent Tool Router)
# ===========================================
# Get your API key from: https://app.composio.dev → Settings → API Keys
COMPOSIO_API_KEY=your-composio-api-key
COMPOSIO_EXTERNAL_USER_ID=your-external-user-id

# ===========================================
# OPENAI (Required for Composio OpenAI Agents)
# ===========================================
OPENAI_API_KEY=your-openai-api-key

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info

# ===========================================
# DEPLOYMENT (DigitalOcean)
# ===========================================
DO_APP_ID=your-app-id
DO_API_TOKEN=your-do-token

# =============================================================================
# Former file: .env.development.example
# =============================================================================
# CCW-Online ERP - Development Environment Configuration
#
# Copy this file to .env (not committed to git)
# For Docker-based development, most settings use defaults from docker-compose.yml
#
# Usage: cp .env.development.example .env

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# =============================================================================
# DATABASE (PostgreSQL via Docker)
# =============================================================================
# Default values match docker-compose.yml
DATABASE_URL=postgresql+asyncpg://starter_user:local_dev_password@localhost:5434/starter_db

# Or specify individual components (used by Docker secrets config)
# DATABASE_HOST=localhost
# DATABASE_PORT=5434
# DATABASE_NAME=starter_db
# DATABASE_USER=starter_user
# DATABASE_PASSWORD=local_dev_password

# =============================================================================
# REDIS (via Docker)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_DB=0
CACHE_ENABLED=true
# REDIS_PASSWORD=  # Not set in dev by default

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Development-only secret - DO NOT use in production
JWT_SECRET_KEY=dev-jwt-secret-change-this-in-production-32-chars-min
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=30

# =============================================================================
# ENCRYPTION (Optional in development)
# =============================================================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# =============================================================================
# SECURITY
# =============================================================================
SECURE_COOKIES=false
RATE_LIMIT_ENABLED=false
SKIP_AUTH_ENFORCEMENT=false

# =============================================================================
# CORS (Frontend URLs)
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:3005","http://localhost:3006","http://localhost:3007"]

# =============================================================================
# AI PROVIDER (Local Ollama by default)
# =============================================================================
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# OPTIONAL: Cloud AI Providers
# =============================================================================
# Uncomment and fill in if using cloud AI
# ANTHROPIC_API_KEY=sk-ant-xxx
# GOOGLE_AI_API_KEY=xxx
# OPENROUTER_API_KEY=sk-or-xxx

# =============================================================================
# OPTIONAL: Email (SendGrid)
# =============================================================================
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@ccw-erp.com

# =============================================================================
# OPTIONAL: Error Tracking (Sentry)
# =============================================================================
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_PROFILES_SAMPLE_RATE=1.0

# =============================================================================
# OPTIONAL: Monitoring Alerts
# =============================================================================
# SMTP_PASSWORD=
# SLACK_WEBHOOK_URL=

# =============================================================================
# OPTIONAL: Integrations
# =============================================================================
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# SHOPIFY_ACCESS_TOKEN=
# STOCKTRIM_API_KEY=

# =============================================================================
# Former file: .env.staging.example
# =============================================================================
# CCW-Online ERP - Staging Environment Configuration
#
# IMPORTANT: This is a TEMPLATE file. DO NOT put real secrets here.
#
# For Docker Compose with secrets:
#   1. Create secret files outside version control (paths in docker-compose.secrets.yml)
#   2. Use docker-compose.secrets.yml
#
# For manual deployment:
#   1. Copy this to .env.staging
#   2. Replace all <PLACEHOLDER> values with real secrets
#   3. NEVER commit the actual .env.staging file
#
# Usage:
#   docker compose -f docker-compose.secrets.yml --env-file .env.staging up -d

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# Option A: Full URL (password embedded - less secure)
# DATABASE_URL=postgresql+asyncpg://ccw_erp_user:<PASSWORD>@<HOST>:5432/ccw_erp_staging

# Option B: Individual components with Docker secrets (recommended)
POSTGRES_DB=ccw_erp_staging
POSTGRES_USER=ccw_erp_user
# Password: env var or Docker secret file (see docker-compose.secrets.yml)
# Or set directly: POSTGRES_PASSWORD=<STRONG_PASSWORD>

# =============================================================================
# REDIS (With Password)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_ENABLED=true
# Password: env var or Docker secret file (see docker-compose.secrets.yml)
# Or set directly: REDIS_PASSWORD=<STRONG_PASSWORD>

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Secret: env var or Docker secret file (see docker-compose.secrets.yml)
# Or set directly (must be 64+ characters for security):
# JWT_SECRET_KEY=<GENERATE_WITH: python -c "import secrets; print(secrets.token_urlsafe(64))">
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=30

# =============================================================================
# ENCRYPTION
# =============================================================================
# Key: env var or Docker secret file (see docker-compose.secrets.yml)
# Or generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=<FERNET_KEY>

# =============================================================================
# SECURITY
# =============================================================================
SECURE_COOKIES=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# CORS (Staging Domain)
# =============================================================================
CORS_ORIGINS=["https://staging.ccw-erp.com","https://api.staging.ccw-erp.com"]

# =============================================================================
# PORTS (Docker Compose)
# =============================================================================
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# =============================================================================
# EMAIL (SendGrid)
# =============================================================================
SENDGRID_API_KEY=<YOUR_SENDGRID_API_KEY>
SENDGRID_FROM_EMAIL=noreply@ccw-erp.com
SENDGRID_FROM_NAME=CCW ERP (Staging)

# =============================================================================
# ERROR TRACKING (Sentry)
# =============================================================================
# Get DSN from: https://sentry.io/settings/[org]/projects/[project]/keys/
SENTRY_DSN=<YOUR_SENTRY_DSN>
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.2
SENTRY_RELEASE=ccw-erp@staging

# Frontend Sentry (separate project)
NEXT_PUBLIC_SENTRY_DSN=<YOUR_FRONTEND_SENTRY_DSN>

# =============================================================================
# MONITORING ALERTS
# =============================================================================
# Slack webhook for alerts
SLACK_WEBHOOK_URL=<YOUR_SLACK_WEBHOOK_URL>

# Email alerts (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<YOUR_EMAIL>
SMTP_PASSWORD=<YOUR_APP_PASSWORD>
ALERT_EMAIL_TO=ops@ccw-erp.com

# =============================================================================
# GRAFANA
# =============================================================================
GRAFANA_URL=https://grafana.staging.ccw-erp.com
# Password: env var or Docker secret file (see docker-compose.secrets.yml)
# Or set directly: GRAFANA_ADMIN_PASSWORD=<STRONG_PASSWORD>

# =============================================================================
# INTEGRATIONS (Optional for Staging)
# =============================================================================
# Xero
XERO_MODE=demo
# XERO_CLIENT_ID=<YOUR_XERO_CLIENT_ID>
# XERO_CLIENT_SECRET=<YOUR_XERO_CLIENT_SECRET>

# Stripe (use test keys for staging)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Shopify (optional)
# SHOPIFY_MODE=demo
# SHOPIFY_ACCESS_TOKEN=<YOUR_SHOPIFY_ACCESS_TOKEN>

# =============================================================================
# AI PROVIDER
# =============================================================================
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>
# Or use Ollama if self-hosted:
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434

# =============================================================================
# NOTES
# =============================================================================
#
# SECRET ROTATION SCHEDULE (Staging):
# - JWT_SECRET_KEY: Every 90 days
# - POSTGRES_PASSWORD: Every 90 days
# - REDIS_PASSWORD: Every 90 days
# - ENCRYPTION_KEY: Only if compromised (data re-encryption required)
#
# BACKUP BEFORE ROTATING:
# 1. Create database backup
# 2. Update secret in secrets manager
# 3. Deploy new containers
# 4. Verify application works
# 5. Keep old secret accessible for 24h (rollback window)

# =============================================================================
# Former file: .env.production.example
# =============================================================================
# CCW-Online ERP - Production Environment Configuration
#
# ⚠️  SECURITY WARNING:
# This is a TEMPLATE file. DO NOT put real secrets here.
# Generate secure secrets using: python scripts/generate-secrets.py
# Store actual secrets in AWS Secrets Manager or HashiCorp Vault.

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<GENERATE_WITH_SCRIPT>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=30

# ==============================================================================
# ENCRYPTION (Fernet AES-256)
# ==============================================================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=<GENERATE_WITH_SCRIPT>

# ==============================================================================
# DATABASE
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://ccw_erp_user:<PASSWORD>@<HOST>:5432/ccw_erp_prod
POSTGRES_PASSWORD=<GENERATE_WITH_SCRIPT>
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ==============================================================================
# REDIS (Caching & Rate Limiting)
# ==============================================================================
REDIS_URL=redis://<HOST>:6379/0
REDIS_PASSWORD=<GENERATE_WITH_SCRIPT>
REDIS_MAX_CONNECTIONS=50

# ==============================================================================
# EMAIL (SendGrid)
# ==============================================================================
SENDGRID_API_KEY=<YOUR_SENDGRID_API_KEY>
SENDGRID_FROM_EMAIL=noreply@ccw-erp.com
SENDGRID_FROM_NAME=CCW Equipment ERP

# ==============================================================================
# XERO INTEGRATION
# ==============================================================================
XERO_CLIENT_ID=<YOUR_XERO_CLIENT_ID>
XERO_CLIENT_SECRET=<GENERATE_WITH_SCRIPT>
# Must match a Redirect URI in Xero Developer Portal exactly (https, host, path; often no trailing slash).
# Must match Xero Developer Portal → Redirect URIs exactly (scheme, host, path, no trailing slash).
XERO_REDIRECT_URI=https://your-domain.com/api/integrations/xero/callback
# Local dev — register this second URI in the same Xero app when testing on localhost.
XERO_REDIRECT_URI_LOCAL=http://localhost:3000/api/integrations/xero/callback
XERO_WEBHOOK_KEY=<GENERATE_WITH_SCRIPT>
XERO_SCOPES=offline_access accounting.transactions accounting.contacts accounting.settings

# ==============================================================================
# GOOGLE AP2 INTEGRATION
# ==============================================================================
AP2_CLIENT_ID=<YOUR_AP2_CLIENT_ID>
AP2_CLIENT_SECRET=<GENERATE_WITH_SCRIPT>
AP2_WEBHOOK_SECRET=<GENERATE_WITH_SCRIPT>
AP2_MODE=production

# ==============================================================================
# CARRIER WEBHOOKS
# ==============================================================================
FEDEX_WEBHOOK_SECRET=<GENERATE_WITH_SCRIPT>
UPS_WEBHOOK_SECRET=<GENERATE_WITH_SCRIPT>
USPS_WEBHOOK_SECRET=<GENERATE_WITH_SCRIPT>

# ==============================================================================
# SECURITY
# ==============================================================================
SECURE_COOKIES=true
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
RATE_LIMIT_ENABLED=true

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================
# Sentry Error Tracking
# Get DSN from: https://sentry.io/settings/[org]/projects/[project]/keys/
SENTRY_DSN=https://your-key@o123456.ingest.sentry.io/your-project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=ccw-erp@1.0.0

# Sentry Auth Token (for source maps upload during build)
# Create at: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=sntrys_your_auth_token_here
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=ccw-erp-backend

# Frontend Sentry (separate project recommended)
NEXT_PUBLIC_SENTRY_DSN=https://your-frontend-key@o123456.ingest.sentry.io/your-frontend-project-id

# Prometheus Metrics
PROMETHEUS_ENABLED=true

# ==============================================================================
# AWS (Optional - for Secrets Manager integration)
# ==============================================================================
AWS_REGION=us-east-1
AWS_SECRET_NAME=ccw-erp/production
USE_AWS_SECRETS=true

# ==============================================================================
# DOCKER SECRETS (Alternative to environment variables)
# ==============================================================================
# For Docker Swarm or Kubernetes, use secret files instead of env vars.
# The application supports loading secrets from files via _FILE suffix:
#
# JWT_SECRET_KEY_FILE=/run/secrets/jwt_secret
# DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
# ENCRYPTION_KEY_FILE=/run/secrets/encryption_key
#
# See docker-compose.secrets.yml for configuration example.

# ==============================================================================
# AI PROVIDER (Production)
# ==============================================================================
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# ==============================================================================
# GENERATION INSTRUCTIONS
# ==============================================================================
#
# STEP 1: Generate all secrets at once:
#   python scripts/generate-secrets.py
#
# STEP 2A: Store in AWS Secrets Manager (RECOMMENDED):
#   aws secretsmanager create-secret \
#     --name ccw-erp/production \
#     --secret-string file://secrets.json \
#     --region us-east-1
#
# STEP 2B: Or use Docker secrets:
#   Create files outside the repo; wire paths in docker-compose.secrets.yml
#
# STEP 3: Configure application:
#   For AWS: export USE_AWS_SECRETS=true
#   For Docker: use docker-compose.secrets.yml
#
# ROTATION SCHEDULE:
#   - JWT_SECRET_KEY: Every 90 days (invalidates user sessions)
#   - POSTGRES_PASSWORD: Every 90 days
#   - REDIS_PASSWORD: Every 90 days
#   - API keys: Per provider recommendations
#   - ENCRYPTION_KEY: Only if compromised (requires data migration)
#
# DOCUMENTATION:
#   - docs/SECRETS_MANAGEMENT.md - AWS Secrets Manager guide
#   - docs/PRODUCTION-SECRETS-SETUP.md - Production setup guide
#   - docs/SECRETS_GENERATION.md - Generating values
#
# ==============================================================================

# =============================================================================
# Former file: .env.shopify.example
# =============================================================================
# Shopify Integration Configuration
# Copy this to backend/.env and fill in your actual credentials

# =============================================================================
# SHOPIFY SETTINGS
# =============================================================================

# Mode: "demo" for testing without real API calls, "live" for real Shopify data
SHOPIFY_MODE=live

# Your Shopify store domain (WITHOUT https://)
# Example: ccwonline.myshopify.com
SHOPIFY_SHOP_DOMAIN=ccwonline.myshopify.com

# Admin API access token from Shopify custom app
# Get this from: Shopify Admin → Settings → Apps and sales channels → Develop apps
# Required scopes: read_products, read_orders, read_customers, read_inventory
SHOPIFY_ACCESS_TOKEN=shpat_your_access_token_here

# API version (use 2024-01 or later)
SHOPIFY_API_VERSION=2024-01

# =============================================================================
# SHOPIFY WEBHOOKS (Optional)
# =============================================================================

# Webhook secret for verifying webhook signatures
# Get this from: Your custom app → API credentials → Webhooks → Secret
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# INVENTORY SYNC (Optional)
# =============================================================================

# Enable/disable automatic inventory synchronization
SHOPIFY_SYNC_INVENTORY=true

# Shopify location ID for inventory updates
# Get this from: Shopify Admin → Settings → Locations
# Or via API: GET /admin/api/2024-01/locations.json
# SHOPIFY_INVENTORY_LOCATION_ID=12345678

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Log in to Shopify Admin: https://ccwonline.myshopify.com/admin
#
# 2. Create a Custom App:
#    - Settings → Apps and sales channels → Develop apps
#    - Click "Allow custom app development" (if needed)
#    - Click "Create an app"
#    - Name: "CCW ERP Integration"
#
# 3. Configure Admin API Scopes:
#    - Click "Configure Admin API scopes"
#    - Select: read_products, read_orders, read_customers, read_inventory
#    - Click "Save"
#
# 4. Install App and Get Token:
#    - Click "Install app"
#    - Copy "Admin API access token"
#    - Paste it above as SHOPIFY_ACCESS_TOKEN
#
# 5. Copy to Backend:
#    - Copy these settings to: backend/.env
#    - Or append to existing .env file
#
# 6. Test Connection:
#    cd backend
#    uv run python -c "from src.integrations.shopify.client import get_shopify_client; import asyncio; asyncio.run(get_shopify_client().get_shop_info())"
#
# 7. Generate Demo Purchases:
#    cd backend
#    uv run python -m src.db.generate_demo_purchases
#
# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# ⚠️ NEVER commit this file with real credentials to Git!
# ⚠️ Keep your SHOPIFY_ACCESS_TOKEN secret
# ⚠️ Rotate tokens if you suspect they've been compromised
# ⚠️ Use read-only scopes when possible
#
# =============================================================================

# =============================================================================
# Former file: backend/.env.example
# =============================================================================
# Backend Environment Variables

# Supabase Configuration (REQUIRED for database)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# API Configuration
BACKEND_API_KEY=your_backend_api_key_here
CORS_ORIGINS=["http://localhost:3000"]

# AI Model API Keys (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-4-6
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.4

# Google AI API Key (REQUIRED for Google AI features)
# Get your API key from: https://makersuite.google.com/app/apikey
# This key is used exclusively for ALL Google AI API calls (Gemini, embeddings, vision)
# SECURITY: Never commit this key to version control
# SECURITY: Keep this key secure and rotate regularly
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Environment
ENVIRONMENT=development
DEBUG=true

# Xero Integration (REQUIRED for bank feed sync)
# Get credentials from: https://developer.xero.com/
XERO_MODE=demo  # Set to "live" for production
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here
XERO_REDIRECT_URI=http://localhost:8000/api/integrations/xero/callback
XERO_ACCESS_TOKEN=your_xero_access_token_here  # OAuth2 access token
XERO_TENANT_ID=your_xero_tenant_id_here  # Organization ID

# SendGrid Email Notifications (REQUIRED for bank feed sync summaries)
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@ccw-erp.com  # Verified sender email
ACCOUNTS_TEAM_EMAIL=accounts@ccw-erp.com  # Email for reconciliation notifications

# Monitoring Alerts (REQUIRED for email/Slack notifications)
# Option 1: Gmail SMTP (recommended for development)
# 1. Enable 2FA on Gmail account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use App Password (16 characters, no spaces) as SMTP_PASSWORD
SMTP_PASSWORD=your_gmail_app_password_here

# Option 2: SendGrid SMTP (recommended for production)
# To use SendGrid for alerts, set SMTP_PASSWORD to your SendGrid API key
# SMTP_PASSWORD=your_sendgrid_api_key_here

# Slack Webhook for critical alerts (OPTIONAL)
# Get webhook URL from: Slack App > Incoming Webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Stripe Billing (REQUIRED for subscription management)
# Get keys from: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for development, live keys (sk_live_...) for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
# Stripe Price IDs (create in Stripe Dashboard > Products)
STRIPE_STARTER_MONTHLY_PRICE_ID=price_starter_monthly_here
STRIPE_STARTER_ANNUAL_PRICE_ID=price_starter_annual_here
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=price_professional_monthly_here
STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=price_professional_annual_here
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_enterprise_monthly_here
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=price_enterprise_annual_here

# Google AP2 (Agent Payments Protocol) Integration (OPTIONAL — required for live payment mode)
# Get credentials from Google Cloud Console > APIs & Services
AP2_MODE=demo  # Set to "live" for production payments
AP2_PROJECT_ID=your_google_cloud_project_id_here
AP2_API_KEY=your_ap2_api_key_here
AP2_OAUTH_CLIENT_ID=your_ap2_oauth_client_id_here
AP2_OAUTH_CLIENT_SECRET=your_ap2_oauth_client_secret_here
AP2_WEBHOOK_SECRET=your_ap2_webhook_secret_here

# Redis Cache (OPTIONAL — defaults to localhost:6379 if not set)
# Required for production caching layer. Install Redis: https://redis.io/download
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Leave blank for no auth (default local Redis setup)
CACHE_ENABLED=true  # Set to "false" to disable Redis caching entirely

# Ollama Local LLM (OPTIONAL — for local AI inference without cloud APIs)
# Install Ollama: https://ollama.ai and run `ollama serve`
OLLAMA_BASE_URL=http://localhost:11434

# Sentry Error Tracking (OPTIONAL — for production error monitoring)
# Get DSN from: https://sentry.io > Project Settings > Client Keys (DSN)
SENTRY_DSN=  # Leave blank to disable Sentry (errors logged locally only)

# OpenAI (OPTIONAL — for embeddings, semantic search)
# Required if using pgvector semantic search (UNI-1235) or OpenAI-based agents
OPENAI_API_KEY=sk-your_openai_api_key_here

# Authentication & Security
# JWT secret used for local dev token signing (production uses Supabase Auth)
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars_here
# AES key for encrypting sensitive fields in the database (must be 32 bytes)
DATABASE_ENCRYPTION_KEY=your_database_encryption_key_32b
# Generic encryption key for application-level secrets
ENCRYPTION_KEY=your_encryption_key_here

# Frontend URL (REQUIRED for OAuth2 redirect URIs and email links)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Cron Job Security (REQUIRED for scheduled task endpoints)
# Generate a random secret: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here
# App user id (UUID) for nightly/cron integration writes when using Bearer CRON_SECRET (Cin7 sync, Shopify imports)
# CRON_INTEGRATION_USER_ID=

# Prometheus Metrics Token (REQUIRED in production — protects /metrics endpoint)
# Generate a random token: openssl rand -hex 32
# If you use file-based metrics auth, store the token where your Prometheus/scrape config expects it
METRICS_TOKEN=your_metrics_token_here

# Generic Webhook Security
WEBHOOK_SECRET=your_webhook_secret_here
# Enable/disable webhook signature verification (set false for local dev)
USE_WEBHOOK_VERIFICATION=false

# AWS (OPTIONAL — for S3 file storage, SES email, or other AWS services)
AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=your_aws_access_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
# AWS_S3_BUCKET=your_s3_bucket_name_here

# Shipping Carriers (OPTIONAL — for shipping rate quotes and tracking)
AUSPOST_API_KEY=your_auspost_api_key_here
STARTRACK_API_KEY=your_startrack_api_key_here
EASYPOST_API_KEY=your_easypost_api_key_here

# Carrier Webhook Secrets (OPTIONAL — for verifying carrier webhook signatures)
FEDEX_WEBHOOK_SECRET=your_fedex_webhook_secret_here
UPS_WEBHOOK_SECRET=your_ups_webhook_secret_here
USPS_WEBHOOK_SECRET=your_usps_webhook_secret_here

# Agent Autonomy Configuration (OPTIONAL — for autonomous development agents)
# Enable/disable autonomous agent code changes (DANGEROUS in production)
AGENT_AUTONOMY_ENABLED=false
# Autonomy level: 0=disabled, 1=suggest-only, 2=read-only, 3=write-allowed
AGENT_AUTONOMY_LEVEL=0
# Rate limiting for autonomous PR creation
AGENT_MAX_PRS_PER_HOUR=2
# Cooldown between autonomous actions (seconds)
AGENT_COOLDOWN_SECONDS=300
# Circuit breaker — pause autonomy after N consecutive failures
AGENT_CIRCUIT_BREAKER_THRESHOLD=3
# Circuit breaker timeout before reset (seconds)
AGENT_CIRCUIT_BREAKER_TIMEOUT_SECONDS=600

# Email Notifications (OPTIONAL — for system alerts and user notifications)
NOTIFICATION_FROM_EMAIL=noreply@ccw-erp.com
ADMIN_NOTIFICATION_EMAIL=admin@ccw-erp.com
SENDGRID_FROM_NAME=CCW ERP System

# Integration Webhook Verification Keys
# Xero webhook signing key (found in Xero Developer Portal > Webhooks)
XERO_WEBHOOK_KEY=your_xero_webhook_key_here
# SendGrid webhook verification key (for inbound parse and event webhooks)
SENDGRID_WEBHOOK_VERIFICATION_KEY=your_sendgrid_webhook_verification_key_here

# Sentry Release Tracking (OPTIONAL — set by CI/CD pipeline)
SENTRY_RELEASE=  # e.g. "1.0.0" or git SHA — leave blank for auto-detection

# Multi-Channel Marketplace Integration (OPTIONAL — for Shopify/eBay/Facebook sync)
# Supports demo mode for testing without real API calls
MARKETPLACE_MODE=demo  # Set to "live" for production marketplace sync
MARKETPLACE_SYNC_INTERVAL=300  # Polling interval in seconds (default: 5 minutes)
MARKETPLACE_BATCH_SIZE=50  # Max products per sync batch
MARKETPLACE_RATE_LIMIT=40  # Max API calls per minute per channel
MARKETPLACE_SYNC_INVENTORY=true  # Enable cross-channel inventory sync
MARKETPLACE_DEFAULT_CURRENCY=AUD  # Default currency for marketplace listings
MARKETPLACE_SHIPPING_POSTCODE=4000  # Australian postcode for shipping origin

# HeyGen Avatar Video Generation (SYN-573 / CCW Video Pipeline)
# Get API key from: https://app.heygen.com/settings?nav=API
HEYGEN_MODE=demo  # Set to "live" for production
HEYGEN_API_KEY=your_heygen_api_key_here

# Example Supabase values:
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

