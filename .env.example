# SENDGRID_TEMPLATE_ID_GENERAL=
# Inbound Parse mailbox (matches your parse host); workspace can override in Settings:
# SENDGRID_INBOUND_MAILBOX=support@yourdomain.com
# Event Webhook — enable Signed Event Webhook in SendGrid, paste verification key:
# SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=
# Inbound + legacy event fallback (query ?token= or Bearer):
# SENDGRID_WEBHOOK_SECRET=
# Fallback owner for inbound when mailbox is env FROM only:
# SENDGRID_INBOUND_OWNER_USER_ID=
# AI_EMAIL_AUTO_RESPONSE=false
# AI_EMAIL_CONFIDENCE_THRESHOLD=0.8
# Development only — browser cookie overrides for API key (disabled in production):
# ALLOW_SENDGRID_BROWSER_OVERRIDES=true

