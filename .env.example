# Production Environment Variables for Backend (FastAPI)
# Copy this file to .env.production and update with your production values

# ============================================
# Project Configuration
# ============================================
PROJECT_NAME="CCW Equipment Supplier ERP"
ENVIRONMENT=production
DEBUG=false

# ============================================
# Security - CORS Configuration
# ============================================
# CRITICAL: Update with your actual production domains
# Format: JSON array of allowed origins
CORS_ORIGINS='["https://ccw-erp.vercel.app","https://www.ccw-erp.com","https://ccw-erp.com"]'

# ============================================
# Database (PostgreSQL via Supabase)
# ============================================
# Supabase Project: CCWiCRM-ERP | Ref: vwfgksqkajnpfjospbpe
#
# What matters for Vercel is the ADDRESS FAMILY of the endpoint, not the port.
# Supabase offers three, and two of them live on the same hostname:
#
#   shared pooler (Supavisor)  aws-<N>-<region>.pooler.supabase.com:6543  IPv4
#   dedicated pooler           db.<ref>.supabase.co:6543                  see below
#   direct                     db.<ref>.supabase.co:5432                  see below
#
# Endpoints on db.<ref>.supabase.co are IPv6-only by default — both the direct
# connection and the dedicated pooler — unless the project has Supabase's IPv4
# add-on enabled. The shared pooler endpoints are IPv4. Resolver measurement,
# 2026-08-08, worth repeating before relying on it:
#
#   dig +short A    db.<ref>.supabase.co                 -> (empty)
#   dig +short AAAA db.<ref>.supabase.co                 -> 2406:da1c:f42:ae13:...
#   dig +short A    aws-1-ap-southeast-2.pooler.supabase.com -> 52.65.247.42 ...
#
# Vercel's serverless egress is IPv4, so unless the IPv4 add-on is on, the only
# endpoint this project can reach from Vercel is the shared pooler.
#
# This file previously recommended db.<ref>.supabase.co:6543?pgbouncer=true.
# That is a well-formed dedicated-pooler URL — the mistake was not its shape but
# its address family. Production login was down on 2026-08-08 with that value
# configured, reporting Prisma `P1008` / `DriverAdapterError: SocketTimeout`.
# That is the symptom that was observed, not a proof of any particular transport
# failure. It is also why /api/health now probes the database rather than
# checking that config exists (#291).
#
# Copy the exact string from the Supabase dashboard: Connect -> Transaction
# pooler. Do NOT assemble it by hand. Two details are easy to get wrong:
#   - the username is `postgres.<PROJECT_REF>`, NOT `postgres`
#     (a plain `postgres` user gives "Tenant or user not found")
#   - the host carries BOTH an index and a region, `aws-<N>-<region>`, and both
#     are project-specific — there is no default to fall back on
#
# Paste the dashboard host in place of <TRANSACTION_POOLER_HOST>. It is left as
# a single opaque placeholder on purpose: a half-real hostname invites someone
# to fill in the rest and get a different broken value.
DATABASE_URL=postgresql://postgres.vwfgksqkajnpfjospbpe:YOUR_PASSWORD_HERE@<TRANSACTION_POOLER_HOST>:6543/postgres?pgbouncer=true
#
# Direct connection (port 5432). Reachable from an IPv6-capable network, which
# includes most local development and any deployment target with IPv6 egress or
# the Supabase IPv4 add-on enabled — but not this project's Vercel deployment as
# currently configured:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@db.vwfgksqkajnpfjospbpe.supabase.co:5432/postgres
#
# Get your password from: https://supabase.com/dashboard/project/vwfgksqkajnpfjospbpe/settings/database
#
# Environment variable changes do not take effect until the next deployment.
# After redeploying, `curl -s https://ccw-crm-web.vercel.app/api/health` reports
# database.reachable truthfully in one call.

# ============================================
# JWT Authentication
# ============================================
# CRITICAL: Generate a strong secret key
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_32_BYTES_OR_MORE
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=30

# ============================================
# Security Settings
# ============================================
# Secure cookies (auto-enabled in production)
SECURE_COOKIES=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# ============================================
# AI Provider Configuration
# ============================================
AI_PROVIDER=anthropic  # or 'ollama' for local

# Anthropic Claude (recommended for production)
ANTHROPIC_API_KEY=sk-ant-api-key-here

# Ollama (if using local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ============================================
# Email (SendGrid)
# ============================================
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@ccw-erp.com
SENDGRID_FROM_NAME="CCW ERP"

# ============================================
# External Integrations (Optional)
# ============================================
# Xero Accounting Integration
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://ccwonline.com.au/api/integrations/xero/callback

# Shopify Integration
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_STORE_URL=

# ElevenLabs Voice (if using voice features)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=

# ============================================
# CCW AI Phone Agent (Twilio + ElevenLabs)
# ============================================
# Set these only when Toby is ready to move from capture/review into live inbound pilot.
FEATURE_CCW_FEASIBILITY_AI_PHONE_AGENT=false
FEATURE_CCW_FEASIBILITY_DASHBOARD=false
FEATURE_CCW_AI_PHONE_AGENT=false
FEATURE_CCW_AI_PHONE_AGENT_AFTER_HOURS=false
FEATURE_CCW_AI_PHONE_AGENT_OUTBOUND=false
FEATURE_CCW_AI_PHONE_RECORDING=false

# Public app origin used to generate webhook URLs and validate Twilio signatures.
# Example: https://crm.ccw.example.com
PHONE_AGENT_PUBLIC_BASE_URL=

# App user id that owns provider-created call sessions.
PHONE_AGENT_OWNER_USER_ID=

# Twilio values from Twilio Console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Shared HMAC secret for ElevenLabs/phone-agent callback verification.
PHONE_AGENT_WEBHOOK_SECRET=

# Development only: allow unsigned Twilio webhook posts from local tooling.
PHONE_AGENT_ALLOW_UNSIGNED_WEBHOOKS=false

# ============================================
# Error Tracking (Sentry)
# ============================================
# Sentry DSN for backend error tracking
# Get from: https://sentry.io/settings/[org]/projects/[project]/keys/
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# ============================================
# API Keys (Optional MCP Tools)
# ============================================
EXA_API_KEY=
REF_TOOLS_API_KEY=

# ============================================
# Model Configuration
# ============================================
DEFAULT_MODEL=claude-sonnet-4-5-20250929
MAX_TOKENS=4096
TEMPERATURE=0.7

# ============================================
# Supabase API Keys
# ============================================
# Get these from: https://supabase.com/dashboard/project/vwfgksqkajnpfjospbpe/settings/api-keys/legacy
#
# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://vwfgksqkajnpfjospbpe.supabase.co
#
# Public Anon Key (safe to use in browser - requires RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
#
# Service Role Key (full database access - NEVER expose to client!)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# =============================================================================
# Former file: apps/web/.env.example
# =============================================================================
# ==============================================
# CCW-ERP Frontend (Next.js) — Environment Variables
# Copy to .env.local for local development
# ==============================================

# ============================================
# Backend API (REQUIRED)
# ============================================
# Primary backend URL used by apiClient and server-side routes
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Legacy alias used by some contractor/websocket modules
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side only (no NEXT_PUBLIC) — used by Next.js API routes for proxying
BACKEND_URL=http://localhost:8000

# ============================================
# App auth (REQUIRED) — Postgres + HS256 JWT
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/your_database
# Used to sign access + refresh tokens (middleware + /api/auth/*). Min ~32 random bytes.
JWT_SECRET=your_jwt_secret_min_32_chars_change_in_production
# Preferred key for encrypting TOTP MFA secrets at rest (falls back to JWT_SECRET if unset)
# MFA_ENCRYPTION_KEY=generate_a_long_random_string
# Enforce MFA for every Optix account (default on). Set false only for local/dev.
# MFA_ENFORCE=true
# MFA_ISSUER=Optix / CCW Online
# Public self-registration is closed unless this is exactly true.
# ALLOW_PUBLIC_REGISTRATION=false
# Stripe card payments: only mark Paid after signed webhook verification
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Database backup encryption (GPG AES-256) + AU S3
# BACKUP_ENCRYPTION_KEY=generate_a_long_random_string
# AWS_DEFAULT_REGION=ap-southeast-2
# S3_BUCKET=s3://ccw-online-erp-backups-ap-southeast-2

# Prisma: npm run db:generate && npm run db:migrate (uses DATABASE_URL)

# ============================================
# Frontend URL (REQUIRED for CORS and OAuth callbacks)
# ============================================
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ============================================
# Security Secrets (REQUIRED for production)
# ============================================
# Cron job authorization — used by /api/cron/health-check
CRON_SECRET=your_cron_secret_here
# Optional — tenant user id for /api/cron/nightly-full-sync integration POSTs (see docs)
# CRON_INTEGRATION_USER_ID=
# Webhook signature verification — used by /api/webhooks
WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# Jina AI Reader (server-side only)
# ============================================
JINA_API_KEY=your_jina_api_key_here
JINA_READER_BASE_URL=https://r.jina.ai/http://

# ============================================
# Monitoring (Prometheus)
# ============================================
PROMETHEUS_URL=http://localhost:9090

# ============================================
# Sentry Error Tracking (OPTIONAL)
# ============================================
# Client-side Sentry DSN (NEXT_PUBLIC exposed to browser)
NEXT_PUBLIC_SENTRY_DSN=
# Server-side + Edge Sentry DSN (not exposed to browser)
SENTRY_DSN=
# Environment label shown in Sentry (development/staging/production)
NEXT_PUBLIC_ENVIRONMENT=development
ENVIRONMENT=development
# Release tag (usually set by CI/CD; leave blank for auto-detect)
NEXT_PUBLIC_RELEASE=
RELEASE=

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# AI Features (OPTIONAL)
# ============================================
NEXT_PUBLIC_AI_ENABLED=true

# ============================================
# Feature Flags (OPTIONAL)
# ============================================
NEXT_PUBLIC_FEATURE_VOICE_ASSISTANT=false
NEXT_PUBLIC_FEATURE_AI_INSIGHTS=true
NEXT_PUBLIC_FEATURE_MULTI_STORE=true

# ============================================
# Analytics (OPTIONAL)
# ============================================
NEXT_PUBLIC_GA_ID=

# ============================================
# Playwright E2E Tests
# ============================================
# Override base URL for Playwright (defaults to http://localhost:3005)
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

