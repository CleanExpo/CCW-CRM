# ===========================================
# STRIPE BILLING CONFIGURATION
# ===========================================
# Copy these to your .env file and replace with your actual keys

# Stripe Secret Key (Backend)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_TEST_SECRET_KEY

# Stripe Webhook Secret (Backend)
# Get from: https://dashboard.stripe.com/webhooks
# Create webhook endpoint: https://your-domain.com/api/billing/webhooks
# Select events: customer.subscription.*, invoice.payment_*
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Publishable Key (Frontend)
# Get from: https://dashboard.stripe.com/apikeys
# Add to apps/web/.env.local
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# STRIPE CONFIGURATION STEPS
# ===========================================

# 1. Create Stripe Account
#    - Go to https://dashboard.stripe.com/register
#    - Verify email and complete onboarding

# 2. Get API Keys
#    - Go to https://dashboard.stripe.com/apikeys
#    - Copy "Publishable key" and "Secret key" from Test mode
#    - Add to .env files

# 3. Create Products & Prices
#    - Go to https://dashboard.stripe.com/products
#    - Create 4 products:
#
#      A. Starter Plan
#         - Name: CCW ERP - Starter
#         - Monthly Price: $79 AUD (price_starter_monthly)
#         - Annual Price: $790 AUD (price_starter_annual)
#
#      B. Professional Plan
#         - Name: CCW ERP - Professional
#         - Monthly Price: $299 AUD (price_professional_monthly)
#         - Annual Price: $2,990 AUD (price_professional_annual)
#
#      C. Enterprise Plan
#         - Name: CCW ERP - Enterprise
#         - Monthly Price: $999 AUD (price_enterprise_monthly)
#         - Annual Price: $9,990 AUD (price_enterprise_annual)
#
#      D. Custom Plan
#         - Name: CCW ERP - Custom
#         - Contact sales (no automated pricing)
#
#    - Note the Price IDs for each (price_xxxxxxxxxxxxx)

# 4. Configure Customer Portal
#    - Go to https://dashboard.stripe.com/settings/billing/portal
#    - Enable these features:
#      ✓ Update payment method
#      ✓ View invoices
#      ✓ Cancel subscription
#    - Set business name and support contact
#    - Upload logo (optional)
#    - Save settings

# 5. Enable Stripe Tax (Optional but Recommended)
#    - Go to https://dashboard.stripe.com/tax
#    - Click "Enable Stripe Tax"
#    - Configure tax registration for your jurisdiction
#    - Set default tax behavior for products

# 6. Set Up Webhooks
#    - Go to https://dashboard.stripe.com/webhooks
#    - Click "Add endpoint"
#    - Endpoint URL: https://your-domain.com/api/billing/webhooks
#      (For local testing: use Stripe CLI or ngrok)
#    - Select these events:
#      ✓ customer.subscription.created
#      ✓ customer.subscription.updated
#      ✓ customer.subscription.deleted
#      ✓ invoice.payment_succeeded
#      ✓ invoice.payment_failed
#    - Click "Add endpoint"
#    - Copy the "Signing secret" (whsec_xxxxx)
#    - Add to STRIPE_WEBHOOK_SECRET above

# 7. Test Locally with Stripe CLI (Optional)
#    - Install: https://stripe.com/docs/stripe-cli
#    - Login: stripe login
#    - Forward webhooks: stripe listen --forward-to localhost:8000/api/billing/webhooks
#    - Trigger test events: stripe trigger customer.subscription.updated

# ===========================================
# STRIPE PRICE IDs (Update after creating products)
# ===========================================
# Update these in: apps/backend/src/db/models/subscription.py

STRIPE_PRICE_STARTER_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_STARTER_ANNUAL=price_xxxxxxxxxxxxx
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_xxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_xxxxxxxxxxxxx

# ===========================================
# TEST CARDS (Test Mode Only)
# ===========================================
# Success: 4242 4242 4242 4242 (Visa)
# Decline: 4000 0000 0000 0002
# Insufficient funds: 4000 0000 0000 9995
# Expired: 4000 0000 0000 0069
# Processing error: 4000 0000 0000 0119

# Use any future expiry date and any 3-digit CVC

# ===========================================
# PRODUCTION DEPLOYMENT
# ===========================================
# When ready for production:
# 1. Switch to live mode in Stripe Dashboard
# 2. Create live products & prices (same as test)
# 3. Update .env with live keys (sk_live_xxx, pk_live_xxx)
# 4. Set up live webhook endpoint
# 5. Test with real payment method
# 6. Enable monitoring & alerts
