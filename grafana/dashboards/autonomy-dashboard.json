{
  "dashboard": {
    "title": "Autonomous Development Framework",
    "tags": ["autonomy", "ai", "development"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "System Health",
        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "url": "http://localhost:8000/api/autonomy/health?window_hours=1",
            "format": "json",
            "method": "GET"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": "/^status$/"
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "healthy": { "text": "Healthy", "color": "green" },
                  "degraded": { "text": "Degraded", "color": "yellow" },
                  "unhealthy": { "text": "Unhealthy", "color": "red" }
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Auto-Merge Success Rate (24h)",
        "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "url": "http://localhost:8000/api/autonomy/metrics?window_hours=24",
            "format": "json",
            "method": "GET"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": "/^rates\\.auto_merge_success_rate$/"
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 0.8, "color": "yellow" },
                { "value": 0.95, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Error Rate (24h)",
        "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "url": "http://localhost:8000/api/autonomy/metrics?window_hours=24",
            "format": "json",
            "method": "GET"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": "/^rates\\.error_rate$/"
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 0.05, "color": "yellow" },
                { "value": 0.1, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Active Anomalies",
        "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "url": "http://localhost:8000/api/autonomy/anomalies?window_hours=24",
            "format": "json",
            "method": "GET"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": "/^anomaly_count$/"
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 1, "color": "yellow" },
                { "value": 3, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "PR Activity Over Time",
        "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "url": "http://localhost:8000/api/autonomy/metrics?window_hours=24",
            "format": "json",
            "method": "GET"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 2,
              "fillOpacity": 10,
              "gradientMode": "none",
              "spanNulls": false,
              "showPoints": "auto",
              "pointSize": 5,
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "axisPlacement": "auto",
              "axisLabel": "",
              "scaleDistribution": {
                "type": "linear"
              },
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "color": {
              "mode": "palette-classic"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "tooltip": {
            "mode": "single",
            "sort": "none"
          },
          "legend": {
            "showLegend": true,
            "displayMode": "list",
            "placement": "bottom"
          }
        }
      },
      {
        "id": 6,
        "type": "piechart",
        "title": "PR Outcomes (24h)",
        "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "url": "http://localhost:8000/api/autonomy/metrics?window_hours=24",
            "format": "json",
            "method": "GET"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "pieType": "pie",
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": ["value", "percent"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              }
            },
            "mappings": []
          }
        }
      },
      {
        "id": 7,
        "type": "table",
        "title": "Recent Audit Log",
        "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "url": "http://localhost:8000/api/autonomy/audit/recent?limit=20",
            "format": "json",
            "method": "GET"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "auto",
              "inspect": false
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                }
              ]
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "result"
              },
              "properties": [
                {
                  "id": "custom.displayMode",
                  "value": "color-background"
                },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "value",
                      "options": {
                        "success": {
                          "color": "green",
                          "text": "SUCCESS"
                        },
                        "failure": {
                          "color": "red",
                          "text": "FAILURE"
                        },
                        "blocked": {
                          "color": "yellow",
                          "text": "BLOCKED"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "displayName": "timestamp",
              "desc": true
            }
          ]
        }
      },
      {
        "id": 8,
        "type": "stat",
        "title": "Total PRs Created (24h)",
        "gridPos": { "x": 0, "y": 20, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "url": "http://localhost:8000/api/autonomy/metrics?window_hours=24",
            "format": "json",
            "method": "GET"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": "/^totals\\.total_prs_created$/"
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "none",
          "graphMode": "area",
          "justifyMode": "auto"
        }
      },
      {
        "id": 9,
        "type": "stat",
        "title": "Auto-Merged (24h)",
        "gridPos": { "x": 6, "y": 20, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "url": "http://localhost:8000/api/autonomy/metrics?window_hours=24",
            "format": "json",
            "method": "GET"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": "/^totals\\.total_auto_merged$/"
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "blue" },
                { "value": 5, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "type": "stat",
        "title": "Rejected (24h)",
        "gridPos": { "x": 12, "y": 20, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "url": "http://localhost:8000/api/autonomy/metrics?window_hours=24",
            "format": "json",
            "method": "GET"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": "/^totals\\.total_rejected$/"
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 3, "color": "yellow" },
                { "value": 10, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "type": "stat",
        "title": "Protected File Violations (24h)",
        "gridPos": { "x": 18, "y": 20, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "url": "http://localhost:8000/api/autonomy/metrics?window_hours=24",
            "format": "json",
            "method": "GET"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": "/^violations\\.protected_file_violations$/"
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 1, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 12,
        "type": "bargauge",
        "title": "Risk Distribution (24h)",
        "gridPos": { "x": 0, "y": 24, "w": 12, "h": 6 },
        "targets": [
          {
            "refId": "A",
            "url": "http://localhost:8000/api/autonomy/metrics?window_hours=24",
            "format": "json",
            "method": "GET"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": "/^risk_distribution\\..*$/"
          },
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 5, "color": "yellow" },
                { "value": 10, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 13,
        "type": "table",
        "title": "Anomalies",
        "gridPos": { "x": 12, "y": 24, "w": 12, "h": 6 },
        "targets": [
          {
            "refId": "A",
            "url": "http://localhost:8000/api/autonomy/anomalies?window_hours=24",
            "format": "json",
            "method": "GET"
          }
        ],
        "options": {
          "showHeader": true
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "left",
              "displayMode": "auto"
            }
          }
        }
      }
    ]
  },
  "overwrite": true
}
