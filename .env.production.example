# CCW-Online ERP - Production Environment Configuration
#
# ⚠️  SECURITY WARNING:
# This is a TEMPLATE file. DO NOT put real secrets here.
# Generate secure secrets using: python scripts/generate-secrets.py
# Store actual secrets in AWS Secrets Manager or HashiCorp Vault.

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<GENERATE_WITH_SCRIPT>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=30

# ==============================================================================
# ENCRYPTION (Fernet AES-256)
# ==============================================================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=<GENERATE_WITH_SCRIPT>

# ==============================================================================
# DATABASE
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://ccw_erp_user:<PASSWORD>@<HOST>:5432/ccw_erp_prod
POSTGRES_PASSWORD=<GENERATE_WITH_SCRIPT>
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ==============================================================================
# REDIS (Caching & Rate Limiting)
# ==============================================================================
REDIS_URL=redis://<HOST>:6379/0
REDIS_PASSWORD=<GENERATE_WITH_SCRIPT>
REDIS_MAX_CONNECTIONS=50

# ==============================================================================
# EMAIL (SendGrid)
# ==============================================================================
SENDGRID_API_KEY=<YOUR_SENDGRID_API_KEY>
SENDGRID_FROM_EMAIL=noreply@ccw-erp.com
SENDGRID_FROM_NAME=CCW Equipment ERP

# ==============================================================================
# XERO INTEGRATION
# ==============================================================================
XERO_CLIENT_ID=<YOUR_XERO_CLIENT_ID>
XERO_CLIENT_SECRET=<GENERATE_WITH_SCRIPT>
XERO_REDIRECT_URI=https://your-domain.com/api/integrations/xero/callback
XERO_WEBHOOK_KEY=<GENERATE_WITH_SCRIPT>
XERO_SCOPES=offline_access accounting.transactions accounting.contacts

# ==============================================================================
# GOOGLE AP2 INTEGRATION
# ==============================================================================
AP2_CLIENT_ID=<YOUR_AP2_CLIENT_ID>
AP2_CLIENT_SECRET=<GENERATE_WITH_SCRIPT>
AP2_WEBHOOK_SECRET=<GENERATE_WITH_SCRIPT>
AP2_MODE=production

# ==============================================================================
# CARRIER WEBHOOKS
# ==============================================================================
FEDEX_WEBHOOK_SECRET=<GENERATE_WITH_SCRIPT>
UPS_WEBHOOK_SECRET=<GENERATE_WITH_SCRIPT>
USPS_WEBHOOK_SECRET=<GENERATE_WITH_SCRIPT>

# ==============================================================================
# SECURITY
# ==============================================================================
SECURE_COOKIES=true
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
RATE_LIMIT_ENABLED=true

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================
SENTRY_DSN=<YOUR_SENTRY_DSN>
PROMETHEUS_ENABLED=true

# ==============================================================================
# AWS (Optional - for Secrets Manager integration)
# ==============================================================================
AWS_REGION=us-east-1
AWS_SECRET_NAME=ccw-erp/production
USE_AWS_SECRETS=true

# ==============================================================================
# GENERATION INSTRUCTIONS
# ==============================================================================
#
# To generate all secrets at once:
#   python scripts/generate-secrets.py
#
# To store in AWS Secrets Manager:
#   aws secretsmanager create-secret \
#     --name ccw-erp/production \
#     --secret-string file://.env.production
#
# To rotate secrets:
#   See docs/SECRETS_MANAGEMENT.md
#
# ==============================================================================
