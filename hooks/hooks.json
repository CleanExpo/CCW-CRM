{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node hooks/pre-bash-safety.js" }]
      },
      {
        "matcher": "mcp__*",
        "hooks": [{ "type": "command", "command": "node hooks/mcp-health-check.js" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node hooks/governance-capture.js" }]
      },
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node hooks/security-scan.js" }]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node hooks/cost-tracker.js" }]
      },
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node hooks/session-state-save.js" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node hooks/session-start-load.js" }]
      }
    ]
  }
}
