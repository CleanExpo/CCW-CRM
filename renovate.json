{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":prHourlyLimit2", ":prConcurrentLimit10"],
  "timezone": "Australia/Sydney",
  "schedule": ["before 6am on monday"],
  "labels": ["renovate", "dependencies"],
  "rangeStrategy": "bump",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate — Dependency Dashboard",
  "packageRules": [
    {
      "description": "Auto-merge patch updates for non-critical dev dependencies once CI is green",
      "matchUpdateTypes": ["patch"],
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge patch updates for production dependencies once CI is green",
      "matchUpdateTypes": ["patch"],
      "matchDepTypes": ["dependencies"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Minor updates: PR but wait for human review",
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "Major updates: human review always; group by package",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["renovate", "dependencies", "major-update"]
    },
    {
      "description": "Next.js / React — critical frameworks, never auto-merge",
      "matchPackageNames": ["next", "react", "react-dom"],
      "automerge": false,
      "labels": ["renovate", "dependencies", "framework"]
    },
    {
      "description": "FastAPI / SQLAlchemy / Pydantic — critical backend, human review",
      "matchPackageNames": ["fastapi", "sqlalchemy", "pydantic"],
      "matchManagers": ["pep621", "poetry", "pip_requirements", "pipenv"],
      "automerge": false,
      "labels": ["renovate", "dependencies", "framework"]
    },
    {
      "description": "Supabase + Stripe SDK — human review; integration surface",
      "matchPackageNames": [
        "@supabase/supabase-js",
        "@supabase/auth-helpers-nextjs",
        "stripe",
        "@stripe/stripe-js"
      ],
      "automerge": false,
      "labels": ["renovate", "dependencies", "integration"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "automerge": true,
    "platformAutomerge": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "vulnerability"]
  },
  "npm": {
    "minimumReleaseAge": "3 days"
  }
}
