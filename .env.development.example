# CCW-Online ERP - Development Environment Configuration
#
# Copy this file to .env (not committed to git)
# For Docker-based development, most settings use defaults from docker-compose.yml
#
# Usage: cp .env.development.example .env

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# =============================================================================
# DATABASE (PostgreSQL via Docker)
# =============================================================================
# Default values match docker-compose.yml
DATABASE_URL=postgresql+asyncpg://starter_user:local_dev_password@localhost:5434/starter_db

# Or specify individual components (used by Docker secrets config)
# DATABASE_HOST=localhost
# DATABASE_PORT=5434
# DATABASE_NAME=starter_db
# DATABASE_USER=starter_user
# DATABASE_PASSWORD=local_dev_password

# =============================================================================
# REDIS (via Docker)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_DB=0
CACHE_ENABLED=true
# REDIS_PASSWORD=  # Not set in dev by default

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Development-only secret - DO NOT use in production
JWT_SECRET_KEY=dev-jwt-secret-change-this-in-production-32-chars-min
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=30

# =============================================================================
# ENCRYPTION (Optional in development)
# =============================================================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# =============================================================================
# SECURITY
# =============================================================================
SECURE_COOKIES=false
RATE_LIMIT_ENABLED=false
SKIP_AUTH_ENFORCEMENT=false

# =============================================================================
# CORS (Frontend URLs)
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:3005","http://localhost:3006","http://localhost:3007"]

# =============================================================================
# AI PROVIDER (Local Ollama by default)
# =============================================================================
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# OPTIONAL: Cloud AI Providers
# =============================================================================
# Uncomment and fill in if using cloud AI
# ANTHROPIC_API_KEY=sk-ant-xxx
# GOOGLE_AI_API_KEY=xxx
# OPENROUTER_API_KEY=sk-or-xxx

# =============================================================================
# OPTIONAL: Email (SendGrid)
# =============================================================================
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@ccw-erp.com

# =============================================================================
# OPTIONAL: Error Tracking (Sentry)
# =============================================================================
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_PROFILES_SAMPLE_RATE=1.0

# =============================================================================
# OPTIONAL: Monitoring Alerts
# =============================================================================
# SMTP_PASSWORD=
# SLACK_WEBHOOK_URL=

# =============================================================================
# OPTIONAL: Integrations
# =============================================================================
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# SHOPIFY_ACCESS_TOKEN=
# STOCKTRIM_API_KEY=
