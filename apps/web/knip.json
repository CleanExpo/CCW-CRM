{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/loading.tsx",
    "app/**/error.tsx",
    "app/**/not-found.tsx",
    "app/**/route.ts",
    "app/api/**/route.ts",
    "instrumentation.ts",
    "middleware.ts",
    "next.config.ts",
    "playwright.config.ts",
    "e2e/**/*.spec.ts",
    "e2e/**/*.setup.ts",
    "__tests__/**/*.test.ts",
    "__tests__/**/*.test.tsx"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "contexts/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}"
  ],
  "ignore": ["tailwind.config.*", "postcss.config.*", "vitest.config.*", ".next/**"],
  "ignoreDependencies": ["@testing-library/jest-dom", "@types/*", "autoprefixer"],
  "next": true,
  "vitest": true
}
