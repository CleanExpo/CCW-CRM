# ==============================================
# CCW-ERP Frontend (Next.js) — Environment Variables
# Copy to .env.local for local development
# ==============================================

# ============================================
# Backend API (REQUIRED)
# ============================================
# Primary backend URL used by apiClient and server-side routes
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Legacy alias used by some contractor/websocket modules
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side only (no NEXT_PUBLIC) — used by Next.js API routes for proxying
BACKEND_URL=http://localhost:8000

# ============================================
# Supabase (REQUIRED)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# New publishable key format (sb_publishable_...) — used by lib/client.ts, lib/server.ts (shadcn SSR pattern)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Server-side service role key (used for admin operations in Next.js API routes)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# Xero Integration (REQUIRED for Xero OAuth)
# Register app at: https://developer.xero.com/app/manage
# App type: Web App | Redirect URI: https://ccw-crm-web.vercel.app/api/integrations/xero/callback
# ============================================
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here
XERO_REDIRECT_URI=https://ccw-crm-web.vercel.app/api/integrations/xero/callback

# ============================================
# Frontend URL (REQUIRED for CORS and OAuth callbacks)
# ============================================
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ============================================
# Security Secrets (REQUIRED for production)
# ============================================
# Cron job authorization — used by /api/cron/health-check
CRON_SECRET=your_cron_secret_here
# Webhook signature verification — used by /api/webhooks
WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# OpenAI (server-side only — semantic search embeddings)
# ============================================
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Jina AI Reader (server-side only)
# ============================================
JINA_API_KEY=your_jina_api_key_here
JINA_READER_BASE_URL=https://r.jina.ai/http://

# ============================================
# Monitoring (Prometheus)
# ============================================
PROMETHEUS_URL=http://localhost:9090

# ============================================
# Error Tracking / Observability
# ============================================
# Sentry was removed in UNI-1949. If you add a replacement (OpenTelemetry,
# Datadog, LogRocket, etc.), add its env vars here.
# Environment label — still used by app code.
NEXT_PUBLIC_ENVIRONMENT=development
ENVIRONMENT=development

# ============================================
# Logging
# ===================