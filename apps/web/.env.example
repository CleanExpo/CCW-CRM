# ==============================================
# CCW-ERP Frontend (Next.js) — Environment Variables
# Copy to .env.local for local development
# ==============================================

# ============================================
# Backend API (REQUIRED)
# ============================================
# Primary backend URL used by apiClient and server-side routes
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Legacy alias used by some contractor/websocket modules
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side only (no NEXT_PUBLIC) — used by Next.js API routes for proxying
BACKEND_URL=http://localhost:8000

# ============================================
# Supabase (REQUIRED)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# New publishable key format (sb_publishable_...) — used by lib/client.ts, lib/server.ts (shadcn SSR pattern)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Server-side service role key (used for admin operations in Next.js API routes)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# Xero Integration (REQUIRED for Xero OAuth)
# Register app at: https://developer.xero.com/app/manage
# App type: Web App | Redirect URI: https://ccw-crm-web.vercel.app/api/integrations/xero/callback
# ============================================
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here
XERO_REDIRECT_URI=https://ccw-crm-web.vercel.app/api/integrations/xero/callback

# ============================================
# Frontend URL (REQUIRED for CORS and OAuth callbacks)
# ============================================
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ============================================
# Security Secrets (REQUIRED for production)
# ============================================
# Cron job authorization — used by /api/cron/health-check
CRON_SECRET=your_cron_secret_here
# Webhook signature verification — used by /api/webhooks
WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# OpenAI (server-side only — semantic search embeddings)
# ============================================
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Jina AI Reader (server-side only)
# ============================================
JINA_API_KEY=your_jina_api_key_here
JINA_READER_BASE_URL=https://r.jina.ai/http://

# ============================================
# Monitoring (Prometheus)
# ============================================
PROMETHEUS_URL=http://localhost:9090

# ============================================
# Sentry Error Tracking (OPTIONAL but recommended for production)
# ============================================
# 1. Create a project at https://sentry.io → Settings → Projects → Create Project
# 2. Copy the DSN from Settings → Client Keys (DSN)
# 3. Set NEXT_PUBLIC_SENTRY_DSN in Vercel: Dashboard → CCW project → Settings → Environment Variables
# Client-side Sentry DSN (NEXT_PUBLIC exposed to browser)
NEXT_PUBLIC_SENTRY_DSN=
# Server-side + Edge Sentry DSN (same value as NEXT_PUBLIC_SENTRY_DSN)
SENTRY_DSN=
# Environment label shown in Sentry (development/staging/production)
NEXT_PUBLIC_ENVIRONMENT=development
ENVIRONMENT=development
# Release tag (usually set by CI/CD; leave blank for auto-detect)
NEXT_PUBLIC_RELEASE=
RELEASE=

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# AI Features (OPTIONAL)
# ============================================
NEXT_PUBLIC_AI_ENABLED=true

# ============================================
# Feature Flags (OPTIONAL)
# ============================================
NEXT_PUBLIC_FEATURE_VOICE_ASSISTANT=false
NEXT_PUBLIC_FEATURE_AI_INSIGHTS=true
NEXT_PUBLIC_FEATURE_MULTI_STORE=true

# ============================================
# Analytics (OPTIONAL)
# ============================================
NEXT_PUBLIC_GA_ID=

# ============================================
# Playwright E2E Tests
# ============================================
# Override base URL for Playwright (defaults to http://localhost:3005)
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
