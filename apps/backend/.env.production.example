# Production Environment Variables for Backend (FastAPI)
# Copy this file to .env.production and update with your production values

# ============================================
# Project Configuration
# ============================================
PROJECT_NAME="CCW Equipment Supplier ERP"
ENVIRONMENT=production
DEBUG=false

# ============================================
# Security - CORS Configuration
# ============================================
# CRITICAL: Update with your actual production domains
# Format: JSON array of allowed origins
CORS_ORIGINS='["https://ccw-erp.vercel.app","https://www.ccw-erp.com","https://ccw-erp.com"]'

# ============================================
# Database (PostgreSQL via Supabase)
# ============================================
# Supabase Project: CCWiCRM-ERP | Ref: vwfgksqkajnpfjospbpe
#
# Connection Pooling (Port 6543) - RECOMMENDED for production/serverless
# Uses PgBouncer for connection pooling - prevents connection exhaustion
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@db.vwfgksqkajnpfjospbpe.supabase.co:6543/postgres?pgbouncer=true
#
# Direct Connection (Port 5432) - Use only if pooling causes issues
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@db.vwfgksqkajnpfjospbpe.supabase.co:5432/postgres
#
# Get your password from: https://supabase.com/dashboard/project/vwfgksqkajnpfjospbpe/settings/database

# ============================================
# JWT Authentication
# ============================================
# CRITICAL: Generate a strong secret key
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_32_BYTES_OR_MORE
JWT_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=30

# ============================================
# Security Settings
# ============================================
# Secure cookies (auto-enabled in production)
SECURE_COOKIES=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# ============================================
# AI Provider Configuration
# ============================================
AI_PROVIDER=anthropic  # or 'ollama' for local

# Anthropic Claude (recommended for production)
ANTHROPIC_API_KEY=sk-ant-api-key-here

# Ollama (if using local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ============================================
# Email (SendGrid)
# ============================================
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@ccw-erp.com
SENDGRID_FROM_NAME="CCW ERP"

# ============================================
# External Integrations (Optional)
# ============================================
# Xero Accounting Integration
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://ccw-erp.vercel.app/api/integrations/xero/callback

# Shopify Integration
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_STORE_URL=

# ElevenLabs Voice (if using voice features)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ============================================
# API Keys (Optional MCP Tools)
# ============================================
EXA_API_KEY=
REF_TOOLS_API_KEY=

# ============================================
# Model Configuration
# ============================================
DEFAULT_MODEL=claude-sonnet-4-5-20250929
MAX_TOKENS=4096
TEMPERATURE=0.7

# ============================================
# Supabase API Keys
# ============================================
# Get these from: https://supabase.com/dashboard/project/vwfgksqkajnpfjospbpe/settings/api-keys/legacy
#
# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://vwfgksqkajnpfjospbpe.supabase.co
#
# Public Anon Key (safe to use in browser - requires RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
#
# Service Role Key (full database access - NEVER expose to client!)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
