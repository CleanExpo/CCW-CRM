# Backend Environment Variables

# Supabase Configuration (REQUIRED for database)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# API Configuration
BACKEND_API_KEY=your_backend_api_key_here
CORS_ORIGINS=["http://localhost:3000"]

# AI Model API Keys (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-4-6
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.4

# Google AI API Key (REQUIRED for Google AI features)
# Get your API key from: https://makersuite.google.com/app/apikey
# This key is used exclusively for ALL Google AI API calls (Gemini, embeddings, vision)
# SECURITY: Never commit this key to version control
# SECURITY: Keep this key secure and rotate regularly
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Environment
ENVIRONMENT=development
DEBUG=true

# Xero Integration (REQUIRED for bank feed sync)
# Get credentials from: https://developer.xero.com/
XERO_MODE=demo  # Set to "live" for production
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here
XERO_REDIRECT_URI=http://localhost:8000/api/integrations/xero/callback
XERO_ACCESS_TOKEN=your_xero_access_token_here  # OAuth2 access token
XERO_TENANT_ID=your_xero_tenant_id_here  # Organization ID

# SendGrid Email Notifications (REQUIRED for bank feed sync summaries)
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@ccw-erp.com  # Verified sender email
ACCOUNTS_TEAM_EMAIL=accounts@ccw-erp.com  # Email for reconciliation notifications

# Monitoring Alerts (REQUIRED for email/Slack notifications)
# Option 1: Gmail SMTP (recommended for development)
# 1. Enable 2FA on Gmail account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use App Password (16 characters, no spaces) as SMTP_PASSWORD
SMTP_PASSWORD=your_gmail_app_password_here

# Option 2: SendGrid SMTP (recommended for production)
# To use SendGrid for alerts, set SMTP_PASSWORD to your SendGrid API key
# SMTP_PASSWORD=your_sendgrid_api_key_here

# Slack Webhook for critical alerts (OPTIONAL)
# Get webhook URL from: Slack App > Incoming Webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Stripe Billing (REQUIRED for subscription management)
# Get keys from: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for development, live keys (sk_live_...) for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
# Stripe Price IDs (create in Stripe Dashboard > Products)
STRIPE_STARTER_MONTHLY_PRICE_ID=price_starter_monthly_here
STRIPE_STARTER_ANNUAL_PRICE_ID=price_starter_annual_here
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=price_professional_monthly_here
STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=price_professional_annual_here
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_enterprise_monthly_here
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=price_enterprise_annual_here

# Google AP2 (Agent Payments Protocol) Integration (OPTIONAL — required for live payment mode)
# Get credentials from Google Cloud Console > APIs & Services
AP2_MODE=demo  # Set to "live" for production payments
AP2_PROJECT_ID=your_google_cloud_project_id_here
AP2_API_KEY=your_ap2_api_key_here
AP2_OAUTH_CLIENT_ID=your_ap2_oauth_client_id_here
AP2_OAUTH_CLIENT_SECRET=your_ap2_oauth_client_secret_here
AP2_WEBHOOK_SECRET=your_ap2_webhook_secret_here

# Redis Cache (OPTIONAL — defaults to localhost:6379 if not set)
# Required for production caching layer. Install Redis: https://redis.io/download
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Leave blank for no auth (default local Redis setup)
CACHE_ENABLED=true  # Set to "false" to disable Redis caching entirely

# Ollama Local LLM (OPTIONAL — for local AI inference without cloud APIs)
# Install Ollama: https://ollama.ai and run `ollama serve`
OLLAMA_BASE_URL=http://localhost:11434

# Sentry Error Tracking (OPTIONAL — for production error monitoring)
# Get DSN from: https://sentry.io > Project Settings > Client Keys (DSN)
SENTRY_DSN=  # Leave blank to disable Sentry (errors logged locally only)

# Example Supabase values:
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
