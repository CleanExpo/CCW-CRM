# Backend Environment Variables

# Supabase Configuration (REQUIRED for database)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# API Configuration
BACKEND_API_KEY=your_backend_api_key_here
CORS_ORIGINS=["http://localhost:3000"]

# AI Model API Keys (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-4-6
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.4

# Google AI API Key (REQUIRED for Google AI features)
# Get your API key from: https://makersuite.google.com/app/apikey
# This key is used exclusively for ALL Google AI API calls (Gemini, embeddings, vision)
# SECURITY: Never commit this key to version control
# SECURITY: Keep this key secure and rotate regularly
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Environment
ENVIRONMENT=development
DEBUG=true

# Xero Integration (REQUIRED for bank feed sync)
# Get credentials from: https://developer.xero.com/
XERO_MODE=demo  # Set to "live" for production
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here
XERO_REDIRECT_URI=http://localhost:8000/api/integrations/xero/callback
XERO_ACCESS_TOKEN=your_xero_access_token_here  # OAuth2 access token
XERO_TENANT_ID=your_xero_tenant_id_here  # Organization ID

# SendGrid Email Notifications (REQUIRED for bank feed sync summaries)
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@ccw-erp.com  # Verified sender email
ACCOUNTS_TEAM_EMAIL=accounts@ccw-erp.com  # Email for reconciliation notifications

# Monitoring Alerts (REQUIRED for email/Slack notifications)
# Option 1: Gmail SMTP (recommended for development)
# 1. Enable 2FA on Gmail account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use App Password (16 characters, no spaces) as SMTP_PASSWORD
SMTP_PASSWORD=your_gmail_app_password_here

# Option 2: SendGrid SMTP (recommended for production)
# To use SendGrid for alerts, set SMTP_PASSWORD to your SendGrid API key
# SMTP_PASSWORD=your_sendgrid_api_key_here

# Slack Webhook for critical alerts (OPTIONAL)
# Get webhook URL from: Slack App > Incoming Webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Stripe Billing (REQUIRED for subscription management)
# Get keys from: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for development, live keys (sk_live_...) for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
# Stripe Price IDs (create in Stripe Dashboard > Products)
STRIPE_STARTER_MONTHLY_PRICE_ID=price_starter_monthly_here
STRIPE_STARTER_ANNUAL_PRICE_ID=price_starter_annual_here
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=price_professional_monthly_here
STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=price_professional_annual_here
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_enterprise_monthly_here
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=price_enterprise_annual_here

# Google AP2 (Agent Payments Protocol) Integration (OPTIONAL — required for live payment mode)
# Get credentials from Google Cloud Console > APIs & Services
AP2_MODE=demo  # Set to "live" for production payments
AP2_PROJECT_ID=your_google_cloud_project_id_here
AP2_API_KEY=your_ap2_api_key_here
AP2_OAUTH_CLIENT_ID=your_ap2_oauth_client_id_here
AP2_OAUTH_CLIENT_SECRET=your_ap2_oauth_client_secret_here
AP2_WEBHOOK_SECRET=your_ap2_webhook_secret_here

# Redis Cache (OPTIONAL — defaults to localhost:6379 if not set)
# Required for production caching layer. Install Redis: https://redis.io/download
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Leave blank for no auth (default local Redis setup)
CACHE_ENABLED=true  # Set to "false" to disable Redis caching entirely

# Ollama Local LLM (OPTIONAL — for local AI inference without cloud APIs)
# Install Ollama: https://ollama.ai and run `ollama serve`
OLLAMA_BASE_URL=http://localhost:11434

# Sentry Error Tracking (OPTIONAL — for production error monitoring)
# Get DSN from: https://sentry.io > Project Settings > Client Keys (DSN)
SENTRY_DSN=  # Leave blank to disable Sentry (errors logged locally only)

# OpenAI (OPTIONAL — for embeddings, semantic search)
# Required if using pgvector semantic search (UNI-1235) or OpenAI-based agents
OPENAI_API_KEY=sk-your_openai_api_key_here

# Authentication & Security
# JWT secret used for local dev token signing (production uses Supabase Auth)
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars_here
# AES key for encrypting sensitive fields in the database (must be 32 bytes)
DATABASE_ENCRYPTION_KEY=your_database_encryption_key_32b
# Generic encryption key for application-level secrets
ENCRYPTION_KEY=your_encryption_key_here

# Frontend URL (REQUIRED for OAuth2 redirect URIs and email links)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Cron Job Security (REQUIRED for scheduled task endpoints)
# Generate a random secret: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Generic Webhook Security
WEBHOOK_SECRET=your_webhook_secret_here
# Enable/disable webhook signature verification (set false for local dev)
USE_WEBHOOK_VERIFICATION=false

# AWS (OPTIONAL — for S3 file storage, SES email, or other AWS services)
AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=your_aws_access_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
# AWS_S3_BUCKET=your_s3_bucket_name_here

# Shipping Carriers (OPTIONAL — for shipping rate quotes and tracking)
AUSPOST_API_KEY=your_auspost_api_key_here
STARTRACK_API_KEY=your_startrack_api_key_here
EASYPOST_API_KEY=your_easypost_api_key_here

# Carrier Webhook Secrets (OPTIONAL — for verifying carrier webhook signatures)
FEDEX_WEBHOOK_SECRET=your_fedex_webhook_secret_here
UPS_WEBHOOK_SECRET=your_ups_webhook_secret_here
USPS_WEBHOOK_SECRET=your_usps_webhook_secret_here

# Agent Autonomy Configuration (OPTIONAL — for autonomous development agents)
# Enable/disable autonomous agent code changes (DANGEROUS in production)
AGENT_AUTONOMY_ENABLED=false
# Autonomy level: 0=disabled, 1=suggest-only, 2=read-only, 3=write-allowed
AGENT_AUTONOMY_LEVEL=0
# Rate limiting for autonomous PR creation
AGENT_MAX_PRS_PER_HOUR=2
# Cooldown between autonomous actions (seconds)
AGENT_COOLDOWN_SECONDS=300
# Circuit breaker — pause autonomy after N consecutive failures
AGENT_CIRCUIT_BREAKER_THRESHOLD=3
# Circuit breaker timeout before reset (seconds)
AGENT_CIRCUIT_BREAKER_TIMEOUT_SECONDS=600

# Email Notifications (OPTIONAL — for system alerts and user notifications)
NOTIFICATION_FROM_EMAIL=noreply@ccw-erp.com
ADMIN_NOTIFICATION_EMAIL=admin@ccw-erp.com
SENDGRID_FROM_NAME=CCW ERP System

# Integration Webhook Verification Keys
# Xero webhook signing key (found in Xero Developer Portal > Webhooks)
XERO_WEBHOOK_KEY=your_xero_webhook_key_here
# SendGrid webhook verification key (for inbound parse and event webhooks)
SENDGRID_WEBHOOK_VERIFICATION_KEY=your_sendgrid_webhook_verification_key_here

# Sentry Release Tracking (OPTIONAL — set by CI/CD pipeline)
SENTRY_RELEASE=  # e.g. "1.0.0" or git SHA — leave blank for auto-detection

# Multi-Channel Marketplace Integration (OPTIONAL — for Shopify/eBay/Facebook sync)
# Supports demo mode for testing without real API calls
MARKETPLACE_MODE=demo  # Set to "live" for production marketplace sync
MARKETPLACE_SYNC_INTERVAL=300  # Polling interval in seconds (default: 5 minutes)
MARKETPLACE_BATCH_SIZE=50  # Max products per sync batch
MARKETPLACE_RATE_LIMIT=40  # Max API calls per minute per channel
MARKETPLACE_SYNC_INVENTORY=true  # Enable cross-channel inventory sync
MARKETPLACE_DEFAULT_CURRENCY=AUD  # Default currency for marketplace listings
MARKETPLACE_SHIPPING_POSTCODE=4000  # Australian postcode for shipping origin

# Example Supabase values:
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
